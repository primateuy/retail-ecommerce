<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Extiende el form del payment.provider OCA (ya inyectado por
            odoo_pos_oca_core) agregando el checkbox is_multiple dentro del
            bloque de credenciales y un tab "Configuración Multiple POS".
        -->
        <record id="payment_provider_form_oca_multiple" model="ir.ui.view">
            <field name="name">payment.provider.form.oca.multiple</field>
            <field name="model">payment.provider</field>
            <field name="inherit_id" ref="odoo_pos_oca_core.payment_provider_form_oca"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='branch']" position="after">
                    <field name="is_multiple"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Configuración Multiple POS"
                          name="multiple_pos_config"
                          invisible="code != 'oca' or not is_multiple">
                        <field name="multiple_pos_ids">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="codigo_terminal"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
