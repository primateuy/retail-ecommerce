<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Diseño de recibo POS con información de CFE (Comprobante Fiscal Electrónico)
        Basado en el ticket de ejemplo de BANTEY S.A.
        
        Este diseño incluye todos los datos del CFE que se generan después de la facturación:
        - Tipo de CFE (eTicket, eFactura, etc.)
        - Serie y Número
        - RUT de la empresa
        - Código de Seguridad
        - URL de verificación
        - Número CAE
        - Rango CAE
        - Fecha de vencimiento CAE
        - Código QR para verificación
    -->

    <record id="pos_receipt_cfe_forum" model="pos.receipt">
        <field name="name">Recibo con CFE (FORUM)</field>
        <field name="design_receipt"><![CDATA[<!-- FORUM v2 -->
        <style>@page { size: 80mm auto; margin: 0; } @media print { body { margin: 0; } }</style>
        <div style="position:relative; width:80mm; margin:0; padding:0; font-family:'Courier New',monospace; font-size:12px; box-sizing:border-box" class="pos-receipt">

            <!-- ===================== ENCABEZADO ===================== -->

            <!-- 1.1 Logo de rutina de impresión -->
            <t t-if="props.data.receipt_logo">
                <div style="text-align:center; margin-bottom:8px; width:100%">
                    <img t-att-src="'data:image/png;base64,' + props.data.receipt_logo"
                         style="max-width:160px; height:auto"/>
                </div>
            </t>

            <!-- Nombre de empresa y RUT (siempre visibles) -->
            <div style="font-size:13px; text-align:center; width:100%">
                <t t-if="props.data.headerData.company.name">
                    <div style="font-weight:bold; font-size:15px; width:100%">
                        <t t-esc="props.data.headerData.company.name" />
                    </div>
                </t>
                <t t-if="props.data.headerData.company.vat">
                    <div style="font-size:12px; width:100%">RUT: <t t-esc="props.data.headerData.company.vat" /></div>
                </t>
                <t t-if="props.pos.env.services.pos.company.phone">
                    <div style="font-size:12px; width:100%">Tel: <t t-esc="props.pos.env.services.pos.company.phone"/></div>
                </t>
            </div>

            <!-- 1.2 Datos de sucursal desde el Punto de Emisión -->
            <t t-if="props.data.cfe_data and props.data.cfe_data.sucursal_nombre">
                <div style="text-align:center; font-size:13px; margin-top:4px; width:100%">
                    <div style="font-weight:bold; width:100%"><t t-esc="props.data.cfe_data.sucursal_nombre"/></div>
                    <t t-if="props.data.cfe_data.sucursal_direccion">
                        <div style="font-size:12px; width:100%">
                            <t t-esc="props.data.cfe_data.sucursal_direccion"/>
                            <t t-if="props.data.cfe_data.sucursal_ciudad">
                                , <t t-esc="props.data.cfe_data.sucursal_ciudad"/>
                            </t>
                        </div>
                    </t>
                </div>
            </t>
            <t t-else="">
                <!-- Fallback: dirección de la empresa -->
                <t t-if="props.data.headerData.company.street">
                    <div style="font-size:12px; text-align:center; width:100%">
                        <t t-esc="props.data.headerData.company.street"/>
                        <t t-if="props.data.headerData.company.city">
                            , <t t-esc="props.data.headerData.company.city"/>
                        </t>
                    </div>
                </t>
            </t>
            <br/>

            <!-- Información del CFE -->
            <t t-if="props.data.cfe_data and (props.data.cfe_data.tipo or props.data.cfe_data.serie or props.data.cfe_data.numero)">
                <div style="font-size:12px; border-top:1px solid black; border-bottom:1px solid black; padding:5px; margin:10px 0; width:100%">
                    <div style="text-align:center; font-weight:bold; margin-bottom:5px; font-size:13px; width:100%">
                        COMPROBANTE FISCAL ELECTRÓNICO
                    </div>
                    <div style="text-align:center; font-size:12px; width:100%">
                        <t t-if="props.data.name">
                            <div style="width:100%">N° <t t-esc="props.data.name"/></div>
                        </t>
                        <t t-if="props.data.cfe_data.tipo">
                            Tipo: <t t-esc="props.data.cfe_data.tipo"/>
                        </t>
                    </div>
                    <div style="text-align:center; font-size:12px; width:100%">
                        <t t-if="props.data.cfe_data.serie">
                            Serie: <t t-esc="props.data.cfe_data.serie"/>
                        </t>
                        <t t-if="props.data.cfe_data.numero">
                            <t t-if="props.data.cfe_data.serie"> - </t>
                            Nro.: <t t-esc="props.data.cfe_data.numero"/>
                        </t>
                    </div>
                    <div style="text-align:center; font-size:12px; width:100%">
                        <t t-if="props.data.cfe_data.ruc_emisor">
                            RUT: <t t-esc="props.data.cfe_data.ruc_emisor"/>
                        </t>
                    </div>
                    <div style="text-align:center; font-size:12px; width:100%">
                        <t t-if="props.data.cfe_data.pago">
                            Pago: <t t-esc="props.data.cfe_data.pago"/>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Mensaje de consumo final -->
            <div style="text-align:center; font-weight:bold; border:2px solid black; padding:8px; margin:10px 0; font-size:13px; width:100%">
                CONSUMO FINAL
            </div>

            <!-- ===================== MONEDA ===================== -->
            <div style="font-size:14px; width:100%">
               <t t-if="props.data.currency_name">
                  Moneda: <t t-esc="props.data.currency_name"/>
               </t>
             </div>

            <!-- ===================== CUERPO ===================== -->
            <!-- 2.5 Tabla de productos — notas y combos a ancho completo, sin precio -->
            <div style="width:100%">
                <table class='receipt-orderlines' style="font-size:13px; border-style:double; border-left:none; border-right:none; border-bottom:none; width:100%; table-layout:fixed">
                    <colgroup>
                        <col style="width:45%"/>
                        <col style="width:15%"/>
                        <col style="width:18%"/>
                        <col style="width:23%"/>
                    </colgroup>
                    <tr style="border-bottom:1px dashed black">
                        <th style="text-align:left">Producto</th>
                        <th style="text-align:right">Cant.</th>
                        <th style="text-align:right">P. Unit.</th>
                        <th style="text-align:right">Total</th>
                    </tr>
                    <t t-if="props.orderlines and props.orderlines.length">
                        <t t-foreach="props.orderlines" t-as="orderline" t-key="orderline_index">
                            <!-- Nota o combo: línea a ancho completo sin cantidades ni precios -->
                            <t t-if="orderline.is_note or orderline.is_combo">
                                <tr>
                                    <td colspan="4" style="padding-top:2%; padding-bottom:2%; text-align:left; font-size:10px; font-style:italic">
                                        <t t-esc="orderline.productName"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-else="">
                                <!-- Línea normal -->
                                <tr>
                                    <td style="padding-top:1%; padding-bottom:1%; text-align:left; font-size:12px">
                                        <t t-esc="orderline.productName"/>
                                        <t t-if="orderline.discount > 0">
                                            <div style="font-size:11px; font-style:italic; color:#808080; width:100%">
                                                <t t-esc="orderline.discount"/>% desc.
                                            </div>
                                        </t>
                                        <t t-if="orderline.customerNote">
                                            <div style="font-size:11px; width:100%" t-esc="orderline.customerNote"/>
                                        </t>
                                    </td>
                                    <td style="text-align:right; font-size:12px"><t t-esc="orderline.qty"/></td>
                                    <td style="text-align:right; font-size:12px">
                                        <t t-if="typeof orderline.unitPrice === 'number'">
                                            <t t-esc="props.pos.env.utils.formatCurrency(orderline.unitPrice).replace('$', '').trim()"/>
                                        </t>
                                        <t t-else=""><t t-esc="(orderline.unitPrice || '').replace('$', '').trim()"/></t>
                                    </td>
                                    <td style="text-align:right; font-size:12px">
                                        <t t-if="typeof orderline.price === 'number'">
                                            <t t-esc="props.pos.env.utils.formatCurrency(orderline.price).replace('$', '').trim()"/>
                                        </t>
                                        <t t-else=""><t t-esc="(orderline.price || '').replace('$', '').trim()"/></t>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </t>
                </table>
            </div>
            <br />

            <!-- Detalle de impuestos con nombres requeridos -->
            <t t-if="props.data.tax_details and props.data.tax_details.length">
                <div style="font-size:12px; border-top:1px dashed; padding-top:5px; width:100%">
                    <table style="width:100%">
                        <tr>
                            <th style="text-align:left">Tasa 22%</th>
                            <th style="text-align:right">IVA</th>
                            <th style="text-align:right">Neto</th>
                        </tr>
                        <tr t-foreach="props.data.tax_details" t-as="tax_detail" t-key="tax_detail_index">
                            <td style="text-align:left; font-size:12px">
                            <t t-if="tax_detail.tax_group_rate !== undefined &amp;&amp; tax_detail.tax_group_rate !== null">
                                    Tasa 22%: <t t-esc="tax_detail.tax_group_rate"/>%
                                </t>
                                <t t-else="">
                                    <t t-esc="tax_detail.tax_group_name"/>
                                </t>
                            </td>
                            <td style="text-align:right; font-size:12px">
                                <t t-if="typeof tax_detail.tax_group_amount === 'number'">
                                    <t t-esc="props.pos.env.utils.formatCurrency(tax_detail.tax_group_amount)"/>
                                </t>
                            </td>
                            <td style="text-align:right; font-size:12px">
                                <t t-if="typeof tax_detail.tax_group_base_amount === 'number'">
                                    <t t-esc="props.pos.env.utils.formatCurrency(tax_detail.tax_group_base_amount)"/>
                                </t>
                            </td>
                        </tr>
                    </table>
                </div>
                <br/>
            </t>

            <!-- Totales -->
            <div style="padding-top:6px; width:100%">
                <div style="font-weight:700; font-size:14px; border-top:1px solid black; padding-top:5px; width:100%">
                    <span style="">TOTAL: </span>
                    <t t-if="typeof props.data.amount_total === 'number'">
                        <span t-esc='props.pos.env.utils.formatCurrency(props.data.amount_total)' class="pos-receipt-right-align"/>
                    </t>
                </div>
                <br/>
            </div>

            <!-- 2.3 Múltiples medios de pago (nombres normalizados por JS/Python) -->
            <t t-foreach='props.paymentlines' t-as='line' t-key="line_index">
                <div style="font-size:13px; border-top:1px dashed; padding-top:5px; width:100%">
                    <span style=""><t t-esc='line.name' /></span>
                    <t t-if="typeof line.amount === 'number'">
                        <span t-esc='props.pos.env.utils.formatCurrency(line.amount)' class="pos-receipt-right-align"/>
                    </t>
                </div>
            </t>

            <!-- Cambio -->
            <div class="receipt-change" style="font-size:13px; border-top:1px dashed; padding-top:5px; width:100%">
                <span style="">CAMBIO: </span>
                <t t-if="typeof props.receipt.change === 'number'">
                    <span t-esc='props.pos.env.utils.formatCurrency(props.receipt.change)' class="pos-receipt-right-align"/>
                </t>
            </div>

            <!-- 2.2 Total Recibido -->
            <t t-if="typeof props.data.total_received === 'number' and props.data.total_received > 0">
                <div style="font-weight:700; font-size:13px; border-top:1px dashed; padding-top:5px; width:100%">
                    <span style="">TOTAL RECIBIDO: </span>
                    <span t-esc='props.pos.env.utils.formatCurrency(props.data.total_received)' class="pos-receipt-right-align"/>
                </div>
            </t>
            <br/>

            <!-- ===================== ADENDA ===================== -->
            <!-- 3.1 Interlineado mejorado entre renglones -->
            <div style="font-size:11px; border-top:1px dashed; padding-top:5px; margin-top:10px; width:100%">
                <div style="text-align:center; font-weight:bold; margin-bottom:6px; font-size:12px; width:100%">
                    ADENDA
                </div>
                <div style="text-align:left; padding-left:10px; line-height:1.6; width:100%">
                    <!-- 3.2 Cajero -->
                    <t t-if="props.data.adenda_data and props.data.adenda_data.cashier">
                        <div style="margin-bottom:4px; width:100%">Cajero: <t t-esc="props.data.adenda_data.cashier"/></div>
                    </t>
                    <!-- 3.2 Vendedor -->
                    <t t-if="props.data.adenda_data and props.data.adenda_data.seller">
                        <div style="margin-bottom:4px; width:100%">Vendedor: <t t-esc="props.data.adenda_data.seller"/></div>
                    </t>
                    <!-- 3.5 Cliente (movido desde encabezado) -->
                    <t t-if="props.data.legal_data and props.data.legal_data.customer_name">
                        <div style="margin-bottom:4px; width:100%">Cliente: <t t-esc="props.data.legal_data.customer_name"/></div>
                    </t>
                    <t t-if="props.data.adenda_data and props.data.adenda_data.points_policy">
                        <div style="margin-bottom:4px; width:100%">Sistema de puntos: <t t-esc="props.data.adenda_data.points_policy"/></div>
                    </t>
                    <!-- 3.3 Puntos de fidelidad en el mismo renglón -->
                    <!-- Si el cliente es Consumidor Final o Empleado no genera puntos de fidelidad.-->

                    <t t-if="props.data.loyalty_visible">
                        <t t-set="loyalty" t-value="props.data.loyaltyStats[0]"/>
                        <div>
                            <!-- Reembolso/orden mixta: getLoyaltyPoints() viene vacío a
                                 propósito (advanced_loyalty_management); solo mostramos
                                 puntos perdidos/devueltos y el saldo actual. -->
                            <t t-if="props.data.loyalty_is_refund">
                                <t t-if="props.data.points_lost != 0">
                                    <t t-if="props.data.points_lost > 0">
                                    Puntos Perdidos: <t t-esc="props.data.points_lost"/>
                                    <br/>
                                    </t>
                                    <t t-if="props.data.points_lost &lt; 0">
                                    Puntos Devueltos: <t t-esc="Math.abs(props.data.points_lost)"/>
                                    <br/>
                                    </t>
                                </t>
                                <t t-if="props.data.loyalty_current_balance !== null">
                                Nuevo Total: <t t-esc="props.data.loyalty_current_balance"/>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-if="loyalty and loyalty.points">
                                    Puntos Acumulados: <t t-esc="loyalty.points.balance - loyalty.points.won"/>
                                </t>
                                <br/>
                                <t t-if="loyalty and loyalty.points.won > 0">
                                Puntos Generados: <t t-esc="loyalty.points.won"/>
                                <br/>
                                </t>
                                <t t-if="props.data.points_lost != 0">
                                    <t t-if="props.data.points_lost > 0">
                                    Puntos Perdidos: <t t-esc="props.data.points_lost"/>
                                    <br/>
                                    </t>
                                    <t t-if="props.data.points_lost &lt; 0">
                                    Puntos Devueltos: <t t-esc="Math.abs(props.data.points_lost)"/>
                                    <br/>
                                    </t>
                                </t>
                                <t t-if="loyalty and loyalty.points.spent > 0">
                                Puntos Canjeados: <t t-esc="loyalty.points.spent"/>
                                <br/>
                                </t>
                                <t t-if="props.data.loyalty_current_balance !== null">
                                 Nuevo Total: <t t-esc="props.data.loyalty_current_balance"/>
                                 </t>
                            </t>
                        </div>
                    </t>
                    <!-- 3.4 Política de cambio: movida a sección EXTRA (después del FIN ADENDA) -->
                </div>
            </div>

            <!-- ===================== EXTRA ===================== -->
            <!-- FIN ADENDA + QR + CAE + Datos legales + Política de cambio -->
            <div style="font-size:11px; border-top:1px dashed; padding-top:5px; margin-top:10px; text-align:center; width:100%">
                <div style="font-weight:bold; margin-bottom:10px; font-size:12px; width:100%">
                    FIN ADENDA
                </div>

                <!-- 4.1 Código QR del CFE -->
                <t t-if="props.data.cfe_data and props.data.cfe_data.qr_base64">
                    <div style="text-align:center; margin:10px 0; width:100%">
                        <img t-att-src="'data:image/png;base64,' + props.data.cfe_data.qr_base64"
                             style="max-width:150px; height:auto"/>
                    </div>
                </t>

                <!-- 4.3 Datos legales: Código de Seguridad -->
                <t t-if="props.data.cfe_data and props.data.cfe_data.codigo_seguridad">
                    <div style="margin-bottom:5px; font-size:11px; width:100%">
                        <strong>Código de Seguridad:</strong> <t t-esc="props.data.cfe_data.codigo_seguridad"/>
                    </div>
                </t>

                <!-- URL de verificación -->
                <t t-if="props.data.cfe_data and props.data.cfe_data.url_verificacion">
                    <div style="margin-bottom:5px; font-size:10px; word-break:break-all; overflow-wrap:break-word; white-space:normal; width:100%">
                        Puede verificar comprobante en:<br/>
                        <t t-esc="props.data.cfe_data.url_verificacion"/>
                    </div>
                </t>

                <!-- 4.2 Datos CAE -->
                <t t-if="props.data.cfe_data and props.data.cfe_data.cae_numero">
                    <div style="margin-top:10px; padding-top:5px; width:100%">
                        <div style="font-size:11px; width:100%"><strong>IVA al día. Nro. CAE:</strong> <t t-esc="props.data.cfe_data.cae_numero"/></div>
                        <t t-if="props.data.cfe_data.cae_rango_desde and props.data.cfe_data.cae_rango_hasta">
                            <div style="font-size:11px; width:100%"><strong>Rango:</strong> <t t-esc="props.data.cfe_data.cae_rango_desde"/> - <t t-esc="props.data.cfe_data.cae_rango_hasta"/></div>
                        </t>
                        <t t-if="props.data.cfe_data.serie">
                            <div style="font-size:11px; width:100%"><strong>Serie:</strong> <t t-esc="props.data.cfe_data.serie"/></div>
                        </t>
                        <t t-if="props.data.cfe_data.cae_fecha_vencimiento">
                            <div style="font-size:11px; width:100%"><strong>Fecha de vencimiento:</strong> <t t-esc="props.data.cfe_data.cae_fecha_vencimiento"/></div>
                        </t>
                    </div>
                </t>

                <!-- 3.4 / 4.4 Política de cambio — centrada, con espacio -->
                <t t-if="props.data.adenda_data and props.data.adenda_data.return_policy">
                    <div style="text-align:center; font-size:11px; margin:12px 4px 6px 4px; padding:6px; border-top:1px dashed; width:100%">
                        <t t-raw="props.data.adenda_data.return_policy"/>
                    </div>
                </t>
            </div>

            <!-- Código de barras del número de orden debajo de la adenda.
                 Ancho/alto fijos + centrado por posición absoluta (igual que en
 `               loyalty_coupon_pos_report.xml). .pos-receipt ahora tiene
                 position:relative para que el left:50% se calcule contra los
                 80mm del recibo y no contra la página completa. -->
            <t t-if="props.data.barcode_src">
                <div style="position:relative; height:80px; margin:12px 0 6px;">
                    <img t-att-src="props.data.barcode_src" alt="Código de barras"
                        style="position:absolute; left:50%; margin-left:-200px; width:400px; height:80px;"/>
                </div>
                <div style="font-family:'Courier New',monospace; font-size:12px; letter-spacing:0.06em; text-align:center; width:100%">
                    <t t-esc="props.data.barcode_value"/>
                </div>
            </t>

            <div class='before-footer' />

            <!-- Footer -->
            <div t-if='props.receipt.footer_html and !props.data.skip_footer' style="text-align:center; font-size:12px; width:100%">
                <t t-raw='props.receipt.footer_html'/>
            </div>
            <div t-if='!props.receipt.footer_html and props.receipt.footer and !props.data.skip_footer' style="text-align:center; font-size:12px; width:100%">
                <br/>
                <t t-esc='props.receipt.footer'/>
                <br/><br/>
            </div>

            <div class='after-footer' style="font-size:12px; width:100%">
                <t t-foreach='props.paymentlines' t-as='line' t-key="line_index">
                    <t t-if='line.ticket'>
                        <br />
                        <div style="width:100%" class="pos-payment-terminal-receipt">
                            <t t-raw='line.ticket'/>
                        </div>
                    </t>
                </t>
            </div>

            <br/><br/>
            <div style="font-size:12px; text-align:center; width:100%">
                ¡Gracias por su compra!
            </div>
            <div style="page-break-after:always"></div>
        </div>]]></field>
    </record>
</odoo>