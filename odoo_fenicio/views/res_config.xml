<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_fenicio" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fenicio</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//form" position="inside">
                <app string="Fenicio" name="odoo_fenicio">
                    <block title="Configuración de Fenicio" name="fenicio_settings">
                        <setting id="fenicio_token_setting" help="Token de autenticación para las peticiones de Fenicio">
                            <field name="fenicio_token" class="oe_inline" password="True"/>
                        </setting>
                        <setting id="fenicio_website_setting" help="Seleccione el sitio web donde se registrarán las ventas procesadas por Fenicio">
                            <field name="fenicio_website_id" class="oe_inline"/>
                        </setting>
                        <setting id="fenicio_pricelist_venta_setting" help="Lista de precios de venta predeterminada para todos los productos Fenicio">
                            <field name="fenicio_pricelist_venta_id" class="oe_inline"/>
                        </setting>
                        <setting id="fenicio_pricelist_lista_setting" help="Lista de precios lista predeterminada para todos los productos Fenicio">
                            <field name="fenicio_pricelist_lista_id" class="oe_inline"/>
                        </setting>
                        <setting id="fenicio_pricelist_alternativo_setting" help="Lista de precios alternativa predeterminada para todos los productos Fenicio">
                            <field name="fenicio_pricelist_alternativo_id" class="oe_inline"/>
                        </setting>
                        <setting id="fenicio_stock_location_setting" help="Ubicaciones de donde se consultará el stock para Fenicio">
                            <field name="fenicio_stock_location_ids" widget="many2many_tags" class="oe_inline"/>
                        </setting>

                        <setting id="fenicio_cantidad_stock_bydefault_setting" help="Cantidad de stock a mostrar por defecto para Fenicio">
                            <field name="cantidad_stock_bydefault" class="oe_inline"/>
                        </setting>
                        <setting id="fenicio_sale_order_type_setting" help="Tipo de orden de venta predeterminado para las ventas procesadas por Fenicio">
                            <field name="fenicio_sale_order_type_id" class="oe_inline"/>
                        </setting>
                        <setting id="fenicio_compania_setting" help="Compañía actual para la que se está configurando Fenicio">
                            <field name="fenicio_compania_id" class="oe_inline"/>
                        </setting>
                        
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>