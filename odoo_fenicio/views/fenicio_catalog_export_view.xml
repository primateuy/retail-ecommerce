<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fenicio_catalog_export_view_form" model="ir.ui.view">
        <field name="name">fenicio.catalog.export.form</field>
        <field name="model">fenicio.catalog.export</field>
        <field name="arch" type="xml">
            <form string="Exportar Catálogo Fenicio">
                <sheet>
                    <field name="state" invisible="1"/>
                    <group invisible="state == 'draft'">
                        <group string="Resultado">
                            <field name="total_productos" readonly="1"/>
                            <field name="excel_file"
                                   filename="file_name"
                                   widget="binary"
                                   string="Descargar Excel"
                                   readonly="1"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_generate"
                                string="Generar Excel"
                                type="object"
                                class="btn-primary"
                                invisible="state == 'done'"/>
                        <button name="action_generate"
                                string="Generar de nuevo"
                                type="object"
                                class="btn-secondary"
                                invisible="state == 'draft'"/>
                        <button name="action_test"
                                string="Probar con datos de ejemplo"
                                type="object"
                                class="btn-secondary"/>
                        <button string="Cerrar" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fenicio_catalog_export_action" model="ir.actions.act_window">
        <field name="name">Exportar Catálogo</field>
        <field name="res_model">fenicio.catalog.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
