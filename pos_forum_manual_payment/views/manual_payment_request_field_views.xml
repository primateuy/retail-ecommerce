<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista árbol del catálogo de campos solicitables -->
    <record id="view_manual_payment_request_field_tree" model="ir.ui.view">
        <field name="name">manual.payment.request.field.tree</field>
        <field name="model">manual.payment.request.field</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence"/>
                <field name="name"/>
                <field name="code"/>
                <field name="field_type"/>
                <field name="relation_model_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Vista formulario del catálogo de campos solicitables -->
    <record id="view_manual_payment_request_field_form" model="ir.ui.view">
        <field name="name">manual.payment.request.field.form</field>
        <field name="model">manual.payment.request.field</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="field_type"/>
                            <field name="relation_model_id" invisible="field_type != 'many2one'"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

