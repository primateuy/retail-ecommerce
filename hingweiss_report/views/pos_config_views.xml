<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista compatible con Community/Enterprise: usa //sheet en lugar de o_settings_container -->
    <record id="pos_config_view_form_codigo_caja_higweiss" model="ir.ui.view">
        <field name="name">pos.config.form.codigo.caja.higweiss</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Hingweiss" name="hingweiss_report">
                    <field name="codigo_caja_higweiss" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
