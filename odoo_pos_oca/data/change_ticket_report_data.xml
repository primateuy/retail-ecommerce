<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Fragmento QWeb reutilizable: voucher tarjeta estilo ticket térmico (Uruguay).
            Se usa en el reporte PDF de voucher OCA (copia empresa).
        -->
        <record id="oca_card_voucher_snippet" model="ir.ui.view">
            <field name="name">odoo_pos_oca.oca_card_voucher_snippet</field>
            <field name="key">odoo_pos_oca.oca_card_voucher_snippet</field>
            <field name="type">qweb</field>
            <field name="arch" type="xml">
                <t t-name="odoo_pos_oca.oca_card_voucher_snippet">
                    <!-- Bloque: variables de apoyo (etiqueta copia, orden POS, datos calculados). -->
                    <t t-set="cl" t-value="copy_label or 'COPIA EMPRESA'"/>
                    <t t-set="order" t-value="tx.pos_order_id"/>
                    <t t-set="branch_partner"
                       t-value="order and (order.config_id.picking_type_id.warehouse_id.partner_id if order.config_id and order.config_id.picking_type_id and order.config_id.picking_type_id.warehouse_id and order.config_id.picking_type_id.warehouse_id.partner_id else (order.config_id.company_id.partner_id if order.config_id and order.config_id.company_id else order.company_id.partner_id))"/>
                    <t t-set="card_masked"
                       t-value="(tx.card_bin or '******') + '******' + (tx.card_last_four or '****')"/>
                    <t t-set="voucher_ref" t-value="tx.ticket_number or tx.reference or ''"/>
                    <!-- Devolución de impuestos: el monto vuelve en TaxAmount y la ley
                         aplicada en TaxRefund (Anexo 3 POSLink v135). El flag depende del
                         monto devuelto por OCA, no del tipo de tarjeta. -->
                    <t t-set="has_tax_refund" t-value="(tx.tax_refund_amount or 0) > 0"/>
                    <!-- Leyenda de la ley aplicada (ej. 'IVA-Ley 19210'); fallback para
                         transacciones previas sin código TaxRefund almacenado. -->
                    <t t-set="tax_law_label" t-value="tx.get_oca_tax_refund_law_label() or 'IVA-Ley 19210'"/>
                    <t t-set="tipo_label" t-value="'Online DEBITO' if has_tax_refund else 'Online CREDITO'"/>
                    <!-- Importe gravado: TaxableAmount que la caja envió en la venta; para
                         transacciones previas sin el dato, aproximación Amount / 1.22. -->
                    <t t-set="gravado" t-value="tx.taxable_amount or round((tx.amount or 0.0) / 1.22, 2)"/>
                    <t t-set="pago" t-value="(tx.amount or 0.0) - (tx.tax_refund_amount or 0.0)"/>
                    <!-- AID EMV: usar el AID real devuelto por OCA (campo
                         emv_application_id); si no vino, caer al AID por marca. -->
                    <t t-set="issuer_lower" t-value="(tx.issuer_name or '').lower()"/>
                    <t t-set="aid_by_brand" t-value="'A0000000041010' if 'master' in issuer_lower else ('A0000000031010' if 'visa' in issuer_lower else '')"/>
                    <t t-set="aid" t-value="tx.emv_application_id or aid_by_brand"/>
                    <!-- Nombre legible del aplicativo EMV (ej. 'VISA DEBITO'). -->
                    <t t-set="emv_app_name" t-value="tx.emv_application_name or ''"/>
                    <t t-set="issuer_aid_label" t-value="(('Debit ' if has_tax_refund else '') + (tx.issuer_name or 'TARJETA'))"/>
                    <t t-set="dgi_code" t-value="tx.provider_id.oca_dgi_code or ''"/>

                    <div class="oca-thermal-voucher"
                         style="font-family: 'Courier New', Courier, monospace; font-size: 13px; line-height: 1.4; width: 100%; max-width: 80mm; margin: 0 auto; color: #000; padding: 4px 0;">

                        <!-- Bloque: encabezado de sucursal (nombre, dirección, ciudad, teléfono) -->
                        <div style="text-align:center; font-weight:bold; margin-bottom:2px;">
                            <span t-if="order and order.config_id" t-field="order.config_id.name"/>
                        </div>
                        <div style="text-align:center; margin-bottom:1px;">
                            <span t-if="branch_partner and branch_partner.street" t-field="branch_partner.street"/>
                        </div>
                        <div style="text-align:center; margin-bottom:1px;">
                            <span t-if="branch_partner and branch_partner.city" t-field="branch_partner.city"/>
                        </div>
                        <div style="text-align:center; margin-bottom:8px;">
                            <span t-if="branch_partner and branch_partner.phone">Telefonos <span t-field="branch_partner.phone"/></span>
                        </div>

                        <!-- Bloque: ref voucher + fecha/hora (izquierda / derecha) -->
                        <!-- No usar widget "time" con t-field sobre Datetime: en 17.x dispara conversor incorrecto. -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:1px;">
                            <tr>
                                <td style="text-align:left; padding:0;"><span>Voucher de Tarjeta</span></td>
                                <td style="text-align:right; padding:0;"><span t-if="voucher_ref" t-esc="voucher_ref"/></td>
                            </tr>
                        </table>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:6px;">
                            <tr>
                                <td style="text-align:left; padding:0;"><span t-if="tx.create_date" t-out="context_timestamp(tx.create_date).strftime('%d/%m/%Y')"/></td>
                                <td style="text-align:right; padding:0;"><span t-if="tx.create_date" t-out="context_timestamp(tx.create_date).strftime('%H:%M:%S')"/></td>
                            </tr>
                        </table>

                        <div style="border-top:1px solid #000; margin-bottom:6px;"></div>

                        <!-- Bloque: datos de la transacción -->
                        <div style="text-align:center; font-weight:bold; margin-bottom:2px;">
                            Nuevo Voucher
                        </div>
                        <div style="text-align:center; font-weight:bold; margin-bottom:6px;">
                            <span t-esc="tx.emv_application_name or tx.issuer_name or tipo_label"/>
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:2px;">
                            <tr>
                                <td style="text-align:left; padding:0;"><span>Tipo: <span t-esc="tipo_label"/></span></td>
                                <td style="text-align:right; padding:0;"><span>Exp: xx/xx</span></td>
                            </tr>
                        </table>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:2px;">
                            <tr>
                                <td style="text-align:left; padding:0;"><span>Operacion: Venta</span></td>
                                <td style="text-align:right; padding:0;"><span>o.Doc: <span t-esc="tx.oca_transaction_id or '-'"/></span></td>
                            </tr>
                        </table>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:2px;">
                            <tr>
                                <td style="text-align:left; padding:0;"><span>Comercio: <span t-esc="tx.merchant_number or '-'"/></span></td>
                                <td style="text-align:right; padding:0;"><span>Term: <span t-esc="tx.pos_id or '-'"/></span></td>
                            </tr>
                        </table>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:2px;">
                            <tr>
                                <td style="text-align:left; padding:0;"><span>Lote: <span t-esc="tx.batch_number or '-'"/></span></td>
                                <td style="text-align:right; padding:0;"><span>Ticket: <span t-esc="tx.ticket_number or '-'"/></span></td>
                            </tr>
                        </table>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:6px;">
                            <tr>
                                <td style="text-align:left; padding:0;"><span>Tarjeta: <span t-esc="card_masked"/></span></td>
                                <td style="text-align:right; padding:0;"><span>NFC</span></td>
                            </tr>
                        </table>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:2px;">
                            <tr>
                                <td style="text-align:left; padding:0;"><span>Plan: <span t-esc="tx.issuer_code or '0'"/></span></td>
                                <td style="text-align:right; padding:0;"><span>Cuotas: <span t-esc="tx.installments or 0"/></span></td>
                            </tr>
                        </table>
                        <div style="margin-bottom:8px;">
                            <span>Autorizacion: <span t-esc="tx.authorization_code or '-'"/></span>
                        </div>

                        <!-- Bloque: AID + nombre aplicativo EMV (formato voucher OCA:
                             AID a la izquierda, nombre legible a la derecha). -->
                        <table t-if="aid or emv_app_name" style="width:100%; border-collapse:collapse; margin-bottom:4px;">
                            <tr>
                                <td style="text-align:left; padding:0;"><span t-esc="aid"/></td>
                                <td style="text-align:right; padding:0;"><span t-esc="emv_app_name or issuer_aid_label"/></td>
                            </tr>
                        </table>

                        <!-- Bloque: importe / devolución IVA / pago -->
                        <table style="width:100%; border-collapse:collapse; font-weight:bold; margin-bottom:2px;">
                            <tr>
                                <td style="text-align:left; padding:0;"><span>Importe $</span></td>
                                <td style="text-align:right; padding:0;"><span t-esc="tx.format_amount(tx.amount)"/></td>
                            </tr>
                        </table>
                        <t t-if="has_tax_refund">
                            <table style="width:100%; border-collapse:collapse; margin-bottom:2px;">
                                <tr>
                                    <td style="text-align:left; padding:0;"><span>Dev. <t t-esc="tax_law_label"/></span></td>
                                    <td style="text-align:right; padding:0;"><span t-esc="tx.format_amount(tx.tax_refund_amount)"/></td>
                                </tr>
                            </table>
                            <table style="width:100%; border-collapse:collapse; font-weight:bold; margin-bottom:2px;">
                                <tr>
                                    <td style="text-align:left; padding:0;"><span>Pago</span></td>
                                    <td style="text-align:right; padding:0;"><span t-esc="tx.format_amount(pago)"/></td>
                                </tr>
                            </table>
                            <table style="width:100%; border-collapse:collapse; margin-bottom:2px;">
                                <tr>
                                    <td style="text-align:left; padding:0;"><span>DGI</span></td>
                                    <td style="text-align:right; padding:0;"><span t-if="dgi_code" t-esc="dgi_code"/></td>
                                </tr>
                            </table>
                            <div style="text-align:center; font-size:11px;">
                                Aplica dev. <t t-esc="tax_law_label"/>
                            </div>
                            <div style="text-align:center; font-size:11px; margin-bottom:8px;">
                                Sin nro. factura no apli
                            </div>
                        </t>

                        <!-- Bloque: importes fiscales (factura / gravado) -->
                        <table style="width:100%; border-collapse:collapse; margin-top:8px;">
                            <tr>
                                <td style="text-align:left; padding:0;"><span>Imp.Factura</span></td>
                                <td style="text-align:right; padding:0;"><span t-esc="tx.format_amount(tx.amount)"/></td>
                            </tr>
                        </table>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:4px;">
                            <tr>
                                <td style="text-align:left; padding:0;"><span>Imp.Gravado TRX</span></td>
                                <td style="text-align:right; padding:0;"><span t-esc="tx.format_amount(gravado)"/></td>
                            </tr>
                        </table>

                        <div style="text-align:center; font-weight:bold; margin-bottom:4px;">
                            *** COMPRA ***
                        </div>

                        <!-- Bloque: conformidad + campos de firma -->
                        <div style="margin-bottom:2px;">
                            Conforme por: $ <span t-esc="int(round(tx.amount or 0))"/>
                        </div>
                        <div style="margin-bottom:10px;">
                            Conforme con la cantidad indicada que debo y pagare al
                            portador del presente contra su presentacion.
                        </div>
                        <div style="margin-bottom:8px;">Nombre: _____________________</div>
                        <div style="margin-bottom:8px;">Telefono: ___________________</div>
                        <div style="margin-bottom:8px;">C.I.: _______________________</div>
                        <div style="margin-bottom:10px;">Firma: ______________________</div>

                        <!-- Bloque: pie copia empresa (barra negra). -->
                        <div style="background:#000; color:#fff; text-align:center; font-weight:bold; padding:6px 4px; margin-top:4px; letter-spacing:0.5px;">
                            *** <span t-esc="cl"/> ***
                        </div>
                    </div>
                </t>
            </field>
        </record>

        <!-- 
        Reporte de ejemplo para Ticket de Cambio
        Este es un reporte básico que puede ser personalizado según las necesidades
        -->
        <record id="action_report_pos_order_change_ticket" model="ir.actions.report">
            <field name="name">Ticket de Cambio POS</field>
            <field name="model">pos.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">odoo_pos_oca.change_ticket_report</field>
            <field name="report_file">odoo_pos_oca.change_ticket_report</field>
            <field name="print_report_name">'Ticket de Cambio - %s' % (object.name)</field>
            <!-- Sin esto hereda el formato de la compañía (A4) o el «Ticket» B7 que
                 quedó puesto a mano en las bases: en los dos casos el ticket sale
                 desplazado y cortado en el rollo de 80 mm. -->
            <field name="paperformat_id" ref="odoo_pos_oca.paperformat_pos_thermal_80"/>
            <field name="binding_model_id" ref="point_of_sale.model_pos_order"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Template QWeb para el ticket de cambio -->
        <!-- El XML ID debe coincidir con el report_name para que el sistema pueda encontrarlo -->
        <record id="change_ticket_report" model="ir.ui.view">
            <field name="name">odoo_pos_oca.change_ticket_report</field>
            <field name="key">odoo_pos_oca.change_ticket_report</field>
            <field name="model">pos.order</field>
            <field name="type">qweb</field>
            <field name="arch" type="xml">
                <t t-call="web.html_container">
                    <t t-call="odoo_pos_oca.thermal_reset_css"/>
                    <t t-foreach="docs" t-as="o">
                        <t t-set="ticket_number" t-value="o.pos_reference or o.name"/>
                        <!-- Nº de orden para texto bajo el código (prioridad: pos_reference). -->
                        <t t-set="order_number" t-value="o.pos_reference or o.name"/>
                        <!-- PNG Code128 embebido en base64 (PDF no resuelve bien /report/barcode/...).
                             Devuelve además el tamaño físico en mm con el que hay que pintarlo. -->
                        <t t-set="barcode_info" t-value="o.get_change_ticket_barcode_info()"/>
                        <t t-set="barcode_data_uri" t-value="barcode_info and barcode_info.get('uri')"/>
                        <t t-set="branch_partner"
                           t-value="(o.config_id.picking_type_id.warehouse_id.partner_id if o.config_id and o.config_id.picking_type_id and o.config_id.picking_type_id.warehouse_id and o.config_id.picking_type_id.warehouse_id.partner_id else (o.config_id.company_id.partner_id if o.config_id and o.config_id.company_id else o.company_id.partner_id))"/>
                        <t t-set="cfe_serie_num" t-value="o.account_move and o.account_move.cfe_serie_num or ''"/>
                        <t t-set="cfe_type_code" t-value="cfe_serie_num.split('-')[0] if cfe_serie_num and '-' in cfe_serie_num else (o.account_move.cfe_type if o.account_move and o.account_move.cfe_type else '')"/>
                        <t t-set="cfe_type_name" t-value="('eTicket' if cfe_type_code in ['101', '111'] else ('eFactura' if cfe_type_code in ['112'] else cfe_type_code))"/>
                        <t t-set="cfe_parts" t-value="cfe_serie_num.split('-') if cfe_serie_num and '-' in cfe_serie_num else []"/>
                        <t t-set="cfe_joined" t-value="' '.join(cfe_parts) if cfe_parts else (cfe_serie_num or cfe_type_code or '')"/>

                        <!-- Diseño tipo ticket térmico (referencia retail Uruguay) -->
                        <div class="page" style="width: 100%; max-width: 80mm; margin: 0 auto; padding: 8px 0; font-family: Arial, Helvetica, sans-serif; font-size: 10px; color: #000; text-transform: uppercase;">

                            <!-- Bloque: marca / nombre comercial (sucursal o compañía) 
                            <div style="text-align:center; font-weight: bold; font-size: 18px; letter-spacing: 1px; margin-bottom: 10px;">
                                <span t-if="o.config_id" t-field="o.config_id.name"/>
                                <span t-if="not o.config_id" t-field="o.company_id.name"/>
                            </div>-->

                            <!-- Bloque: datos fiscales en recuadro (razón social) -->
                            <div style="border: 1px solid #000; padding: 8px 6px; text-align: center; margin-bottom: 10px; line-height: 1.35;">
                                <div style="font-weight: bold; font-size: 11px;">
                                    <span t-field="o.company_id.name"/>
                                </div>
                                <div t-if="branch_partner and branch_partner.vat">
                                    RUT: <span t-field="branch_partner.vat"/>
                                </div>
                                <div t-if="branch_partner and branch_partner.phone">
                                    Teléfono: <span t-field="branch_partner.phone"/>
                                </div>
                                <div t-if="branch_partner and (branch_partner.street or branch_partner.city)">
                                    <span t-if="branch_partner.street" t-field="branch_partner.street"/>
                                    <t t-if="branch_partner.street and branch_partner.city"> - </t>
                                    <span t-if="branch_partner.city" t-field="branch_partner.city"/>
                                </div>
                            </div>

                            <!-- Bloque: metadatos CFE / factura / fecha (referencia ticket físico) -->
                            <div style="width: 100%; margin-bottom: 8px; font-size: 9px; overflow: hidden;">
                                <div style="float: right; text-align: right; max-width: 45%;">
                                    <div t-if="o.account_move and o.account_move.name">
                                        <span t-field="o.account_move.name"/>
                                    </div>
                                    <div t-if="o.date_order">
                                        <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                                    </div>
                                </div>
                            </div>

                            <div style="margin-bottom: 8px; font-size: 10px;">
                                <strong>TICKET DE CAMBIO</strong> <span t-esc="ticket_number"/>
                            </div>
                            <div style="margin-bottom: 10px; font-size: 9px;">
                                <span t-if="cfe_type_name">Tipo CFE: <span t-esc="cfe_type_name"/></span>
                                <span t-if="cfe_serie_num"> | CFE: <span t-esc="cfe_serie_num"/></span>
                            </div>

                            <!-- Bloque: vendedor (sin listado de productos ni precios en ticket de cambio).
                                 Usa el vendedor de la orden (order_salesperson_id, módulo
                                 pos_forum_salesperson_required), no el usuario que imprime/inició sesión.
                                 Fallback a user_id cuando ese módulo no está instalado. -->
                            <t t-set="ticket_vendor"
                               t-value="o.order_salesperson_id.name if ('order_salesperson_id' in o._fields and o.order_salesperson_id) else (o.user_id.name if o.user_id else '')"/>
                            <div style="margin-bottom: 8px; font-size: 10px;">
                                VENDEDOR: <span t-esc="ticket_vendor"/>
                            </div>

                            <!-- Código de barras nº de orden (entre vendedor y PDV / sucursal).
                                 El barcode se dimensiona en mm y SIEMPRE entra dentro de los 80 mm de
                                 .page. La versión anterior lo pintaba a 400 px con position:absolute y
                                 margin-left:-200px, así que sobresalía ~49 px de cada lado del papel:
                                 el recorte se comía la quiet zone y ~4,8 módulos de los patrones de
                                 start (11 módulos) y stop (13 módulos) de Code128, lo que dejaba el
                                 código imposible de decodificar. Centrado normal, sin desbordar. -->
                            <div t-if="barcode_data_uri" style="text-align: center; margin: 10px 0 4px 0;">
                                <img t-att-src="barcode_data_uri" alt="Orden"
                                     t-attf-style="display: block; margin: 0 auto; width: {{ barcode_info['width_mm'] }}mm; height: {{ barcode_info['height_mm'] }}mm; max-width: 100%; image-rendering: pixelated; image-rendering: -moz-crisp-edges; image-rendering: -webkit-optimize-contrast;"/>
                            </div>
                            <div t-if="barcode_data_uri" style="text-align: center; font-size: 9px; margin-bottom: 8px; text-transform: none;">
                                <span t-esc="order_number"/>
                            </div>

                            <!-- PDV / sucursal (debajo del código de barras) -->
                            <div style="margin-bottom: 12px; font-size: 10px; text-align: center; line-height: 1.35;">
                                <div t-if="o.config_id and o.config_id.picking_type_id and o.config_id.picking_type_id.warehouse_id"
                                     style="margin-top: 4px;">
                                    <span>SUCURSAL: </span>
                                    <span t-field="o.config_id.picking_type_id.warehouse_id.name"/>
                                    <span t-if="o.config_id.picking_type_id.warehouse_id.code">
                                        (<span t-field="o.config_id.picking_type_id.warehouse_id.code"/>)
                                    </span>
                                </div>
                            </div>

                            <!-- Política de cambios (destacada) -->
                            <div style="text-align: center; font-weight: bold; font-size: 13px; margin: 14px 0 8px 0; line-height: 1.25;">
                                LOS CAMBIOS SE PODRAN REALIZAR DENTRO DE UN PLAZO DE 30 DIAS
                            </div>

                            <div style="text-align: center; font-size: 9px; margin-top: 12px; color: #000;">
                                <span t-if="o.session_id">Sesion: <span t-field="o.session_id.name"/></span>
                            </div>
                        </div>
                    </t>
                </t>
            </field>
        </record>

        <!-- Reporte de voucher OCA (payment.transaction) -->
        <record id="action_report_payment_transaction_oca_voucher" model="ir.actions.report">
            <field name="name">Voucher OCA POS</field>
            <field name="model">payment.transaction</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">odoo_pos_oca.payment_transaction_oca_voucher_report</field>
            <field name="report_file">odoo_pos_oca.payment_transaction_oca_voucher_report</field>
            <field name="print_report_name">'Voucher OCA - %s' % (object.reference or object.id)</field>
            <field name="paperformat_id" ref="odoo_pos_oca.paperformat_pos_thermal_80"/>
            <field name="binding_model_id" ref="payment.model_payment_transaction"/>
            <field name="binding_type">report</field>
        </record>

        <record id="payment_transaction_oca_voucher_report" model="ir.ui.view">
            <field name="name">odoo_pos_oca.payment_transaction_oca_voucher_report</field>
            <field name="key">odoo_pos_oca.payment_transaction_oca_voucher_report</field>
            <field name="model">payment.transaction</field>
            <field name="type">qweb</field>
            <field name="arch" type="xml">
                <t t-call="web.html_container">
                    <t t-call="odoo_pos_oca.thermal_reset_css"/>
                    <t t-foreach="docs" t-as="tx">
                        <div class="article o_report_layout_standard" style="padding: 4px 0; margin: 0; width: 100%; max-width: 100%;">
                            <t t-set="copy_label" t-value="'COPIA EMPRESA'"/>
                            <t t-call="odoo_pos_oca.oca_card_voucher_snippet"/>
                        </div>
                    </t>
                </t>
            </field>
        </record>
    </data>
</odoo>
