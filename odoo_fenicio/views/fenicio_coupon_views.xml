<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fenicio_coupon_view_tree" model="ir.ui.view">
        <field name="name">fenicio.coupon.tree</field>
        <field name="model">fenicio.coupon</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not active">
                <field name="code"/>
                <field name="description"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="discount_currency"/>
                <field name="min_amount" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_free_shipping" optional="show"/>
                <field name="sale_order_count" optional="show"/>
                <field name="website_id" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="fenicio_coupon_view_form" model="ir.ui.view">
        <field name="name">fenicio.coupon.form</field>
        <field name="model">fenicio.coupon</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="sale_order_count" widget="statinfo" string="Usos"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1><field name="code" placeholder="PRE123456"/></h1>
                    </div>
                    <group>
                        <group string="Descuento">
                            <field name="description"/>
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="discount_currency"/>
                            <field name="min_amount"/>
                            <field name="product_groups" placeholder="54,32"/>
                        </group>
                        <group string="Vigencia">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="website_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Condiciones">
                            <field name="is_free_shipping"/>
                            <field name="is_cumulative_product_discount"
                                   readonly="discount_type == 'montofijo'" force_save="1"/>
                            <field name="is_cumulative_payment_discount"
                                   readonly="discount_type == 'montofijo'" force_save="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fenicio_coupon_view_search" model="ir.ui.view">
        <field name="name">fenicio.coupon.search</field>
        <field name="model">fenicio.coupon</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="description"/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Tipo de descuento" name="group_discount_type"
                            context="{'group_by': 'discount_type'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
