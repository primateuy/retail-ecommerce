<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_form_inherit_fenicio" model="ir.ui.view">
        <field name="name">website.form.inherit.fenicio</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Fenicio" name="fenicio">
                    <group string="Configuración">
                        <group>
                            <field name="fenicio_catalog_url" placeholder="https://example.com/"/>
                            <field name="fenicio_token" password="True"/>
                            <field name="fenicio_sale_order_type_id"/>
                            <field name="fenicio_cantidad_stock_bydefault"/>
                        </group>
                        <group>
                            <field name="fenicio_pricelist_venta_id"/>
                            <field name="fenicio_pricelist_lista_id"/>
                            <field name="fenicio_pricelist_alternativo_id"/>
                            <field name="fenicio_stock_location_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Catálogo" col="1">
                        <div class="d-flex gap-2 flex-wrap mt-1 mb-2">
                            <button name="action_open_catalog_sync"
                                    string="Sincronizar Catálogo"
                                    type="object"
                                    class="btn btn-primary"/>
                            <button name="action_open_catalog_test"
                                    string="Sincronización manual"
                                    type="object"
                                    class="btn btn-secondary"/>
                            <button name="action_open_catalog_list"
                                    string="Ver Catálogo"
                                    type="object"
                                    class="btn btn-secondary"/>
                            <button name="action_open_catalog_export"
                                    string="Exportar a Excel"
                                    type="object"
                                    class="btn btn-secondary"/>
                            <button name="action_open_logs"
                                    string="Ver Logs"
                                    type="object"
                                    class="btn btn-secondary"/>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>