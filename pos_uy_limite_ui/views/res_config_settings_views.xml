<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ui_limit" model="ir.ui.view">
        <field name="name">res.config.settings.form.pos.ui.limit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting
                    id="pos_ui_limit"
                    string="Control de monto maximo FE"
                    help="Antes de cobrar, bloquea la venta si el total supera el monto maximo FE configurado en el cliente (pestana Control FE del contacto)."
                >
                    <field name="pos_ui_limit_enabled" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
