<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PaymentScreenPaymentLinesManualButton" t-inherit="point_of_sale.PaymentScreenPaymentLines"
       t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('payment-amount')]" position="before">
            <div>
                <t t-if="line.payment_method.manual_transaction_enabled and !line.payment_method.allow_check_info">
                    <i
                       t-on-click="() => this._ManualInfoClicked(line.cid)"
                       class="oe_link_icon fa fa-bank oe_icon line-lot-icon oe_red"
                       aria-label="Manual Payment Info"
                       title="Manual Payment Info"
                       style="margin-top:80%;"
                    />
                </t>
            </div>
        </xpath>

        <xpath expr="//t[@t-else='']//div[hasclass('payment-amount')]" position="before">
            <div>
                <t t-if="line.payment_method.manual_transaction_enabled and !line.payment_method.allow_check_info">
                    <i
                       t-on-click="() => this._ManualInfoClicked(line.cid)"
                       class="oe_link_icon fa fa-bank oe_icon line-lot-icon oe_red"
                       aria-label="Manual Payment Info"
                       title="Manual Payment Info"
                       style="margin-top:80%;"
                    />
                </t>
            </div>
        </xpath>
    </t>
</templates>

