<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mercado_pago_applications_view_form" model="ir.ui.view">
            <field name="name">mercado_pago.applications.form</field>
            <field name="model">mercado_pago.applications</field>
            <field name="arch" type="xml">
                <form string="Mercado Pago Application">
                    <sheet>
                        <group>
                            <group string="General">
                                <field name="name"/>
                                <field name="company_id"/>
                                <field name="mp_user_id"/>
                            </group>
                            <group string="Credenciales OAuth">
                                <field name="client_id"/>
                                <field name="client_secret" widget="password"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mercado_pago_applications_view_tree" model="ir.ui.view">
            <field name="name">mercado_pago.applications.tree</field>
            <field name="model">mercado_pago.applications</field>
            <field name="arch" type="xml">
                <tree string="Mercado Pago Applications">
                    <field name="name"/>
                    <field name="mp_user_id"/>
                    <field name="company_id"/>
                    <field name="client_id"/>
                </tree>
            </field>
        </record>

        <record id="mercado_pago_applications_action" model="ir.actions.act_window">
            <field name="name">Aplicaciones</field>
            <field name="res_model">mercado_pago.applications</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
