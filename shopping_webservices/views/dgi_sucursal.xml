<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<record id="view_dgi_sucursal_form_inherit_shopping_webservices" model="ir.ui.view">
		<field name="name">dgi.sucursal.form.inherit.shopping_webservices</field>
		<field name="model">dgi.sucursal</field>
		<field name="inherit_id" ref="l10n_uy_einvoice_base.view_dgi_sucursal_form"/>
		<field name="arch" type="xml">
			<xpath expr="//sheet" position="inside">
				<notebook>
					<page string="Shopping Webservices" name="shopping_webservices">
						<group>
							<group>
								<field name="shopping_technology"/>
								<field name="shopping_url"/>
								<field name="shopping_user"
									invisible="shopping_technology != 'costa_urbana'"/>
								<field name="shopping_password" password="True"/>
								<field name="is_shopping_homologation"/>
							</group>
							<group>
								<field name="shopping_code"/>
								<field name="shopping_contract_number"/>
								<field name="shopping_channel_code"/>
								<field name="shopping_category_code"/>
								<field name="shopping_sales_sequence"
									invisible="shopping_technology != 'costa_urbana'"/>
							</group>
						</group>
						<group>
							<field name="shopping_payment_method_ids" widget="many2many_tags"/>
						</group>
					</page>
				</notebook>
			</xpath>
		</field>
	</record>

</odoo>
