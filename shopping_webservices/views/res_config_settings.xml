                                    <field name="rut" placeholder="Ingrese el RUT de la compañía"/>
                                </div>
                                <div class="o_setting_box o_setting_box_full">
                                    <span class="o_form_label">Password</span>
                                    <div class="text-muted">Password para acceso a la API (si aplica)</div>
                                    <field name="password" password="True" placeholder="Contraseña API"/>
                                </div>
