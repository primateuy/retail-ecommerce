<odoo>
    <data>
        <!-- Vista form -->
        <record id="store_tills_view_form" model="ir.ui.view">
            <field name="name">store.tills.form</field>
            <field name="model">store.tills</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group string="till Info" name="till_info">
                            <group>
                                <field name="name" placeholder="till 1"/>
                                <field name="store_branch_id" options="{ 'no_create': True }" readonly="pos_id_mp"/>
                                <field name="fixed_amount" readonly="pos_id_mp"/>
                            </group>
                            <group>
                                <field name="external_id" readonly="1"/>
                                <field name="category" readonly="pos_id_mp"/>
                            </group>
                        </group>
                        <group string="MercadoPago Info" name="till_mp_info" invisible="not pos_id_mp">
                            <group>
                                <field name="pos_id_mp" readonly="1"/>
                                <field name="status_mp" readonly="1"/>
                                <field name="uuid_mp" readonly="1"/>
                                <field name="user_id_mp" readonly="1"/>
                            </group>
                            <group>
                                <field name="qr_url" readonly="1"/>
                                <field name="qr_template_document" readonly="1"/>
                                <field name="qr_template_image" readonly="1"/>
                                <field name="qr_code" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista tree -->
        <record id="store_tills_view_tree" model="ir.ui.view">
            <field name="name">store.tills.tree</field>
            <field name="model">store.tills</field>
            <field name="arch" type="xml">
                <tree string="">
                    <field name="name"/>
                    <field name="store_branch_id"/>
                </tree>
            </field>
        </record>

        <!-- Vista action -->
        <record id="store_tills_views_action" model="ir.actions.act_window">
            <field name="name">Store Tills</field>
            <field name="res_model">store.tills</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>