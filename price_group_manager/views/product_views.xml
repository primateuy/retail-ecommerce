<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Herencia de la vista de formulario de producto template -->
        <record id="product_template_form_view_inherit_price_group" model="ir.ui.view">
            <field name="name">product.template.common.form.inherit.price.group</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Agrupadores de Precio" name="price_groups">
                        <group>
                            <group>
                                <field name="x_current_price_group_id" readonly="1"/>
                                <field name="x_price_group_count" widget="statinfo" string="Total Agrupadores"/>
                            </group>
                            <group>
                                <button name="action_add_price_group" 
                                        type="object" 
                                        string="Agregar Agrupador" 
                                        class="btn-primary"/>
                                <button name="action_view_price_groups" 
                                        type="object" 
                                        string="Ver Agrupadores" 
                                        class="btn-secondary"/>
                            </group>
                        </group>
                        
                        <field name="x_price_group_line_ids" readonly="1">
                            <tree string="Agrupadores de Precio">
                                <field name="price_group_id"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="origin"/>
                                <field name="is_current"/>
                                <field name="active"/>
                            </tree>
                        </field>
                        
                        <group>
                            <button name="action_force_price_group_sync" 
                                    type="object" 
                                    string="Forzar Sincronización en Variantes" 
                                    class="btn-warning"
                                    confirm="¿Está seguro de que desea forzar la sincronización? Esto eliminará todas las líneas de agrupador de las variantes y las reemplazará con las del template."/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Herencia de la vista de lista de producto template -->
        <record id="product_template_tree_view_inherit_price_group" model="ir.ui.view">
            <field name="name">product.template.common.tree.inherit.price.group</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='list_price']" position="after">
                    <field name="x_current_price_group_id" optional="show"/>
                    <field name="x_price_group_count" optional="show"/>
                </xpath>
            </field>
        </record>

