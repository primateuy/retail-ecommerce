<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="pos_payment_form" model="ir.ui.view">
            <field name="name">pos_payment_form</field>
            <field name="model">pos.payment</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='transaction_id']" position="after">
                    <field name="payment_transaction_id" string="Transacción de Pago OCA" readonly="1"/>
                    <field name="pos_session_id" string="Sesión POS" readonly="1" 
                           invisible="not pos_session_id"/>
                    <field name="ticket" string="Número de ticket"/>
                    <field name="invoice_number" string="Número de Factura"/>
                    <field name="installments" string="Número de Cuotas"/>
                    <field name="is_promotion" string="Es Promoción"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
