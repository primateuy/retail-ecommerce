<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Borra las llamadas a OCA de más de odoo_pos_oca.envio_dias días (90 por defecto). -->
        <record id="ir_cron_oca_envio_limpiar" model="ir.cron">
            <field name="name">OCA: limpiar llamadas registradas</field>
            <field name="model_id" ref="model_oca_envio"/>
            <field name="state">code</field>
            <field name="code">model._cron_limpiar()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
