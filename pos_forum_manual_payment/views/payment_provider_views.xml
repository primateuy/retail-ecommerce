<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión de vista de payment.provider para configuración POS manual -->
    <record id="view_payment_provider_form_pos_manual" model="ir.ui.view">
        <field name="name">payment.provider.form.pos.manual</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'forum_manual' and code != 'oca'">
                    <field name="manual_pos_provider" invisible="code != 'forum_manual'"/>
                    <field name="url_webservice" invisible="code != 'forum_manual'" required="code == 'forum_manual' or code == 'oca'"/>
                    <field name="codigo_sistema" invisible="code != 'forum_manual'" required="code == 'forum_manual' or code == 'oca'"/>
                    <field name="client_app_id" invisible="code != 'forum_manual'" required="code == 'forum_manual' or code == 'oca'"/>
                    <field name="codigo_sucursal" invisible="code != 'forum_manual'" required="code == 'forum_manual' or code == 'oca'"/>
                </group>
            </group>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="POS Manual" invisible="not manual_pos_provider or code != 'forum_manual'">
                    <group invisible="code != 'forum_manual'">
                        <field name="manual_journal_id"/>
                        <field name="manual_merchant_number"/>
                        <field name="has_multiple_pos"/>
                    </group>
                    <group invisible="code != 'forum_manual' or has_multiple_pos != True">
                        <field name="multiple_pos_ids" mode="tree">
                            <tree string="POS permitidos" editable="bottom">
                                <field name="name"/>
                                <field name="codigo_terminal"/>
                            </tree>
                            <form>
                                <group>
                                    <field name="name"/>
                                    <field name="codigo_terminal"/>
                                </group>
                            </form>
                        </field>
                    </group>
                    <group>
                        <field name="manual_field_config_ids" mode="tree">
                            <tree editable="bottom">
                                <field name="sequence"/>
                                <field name="request_field_id"/>
                                <field name="transaction_field_mapping"/>
                                <field name="request_field_type" readonly="1"/>
                                <field name="required"/>
                                <field name="default_char_value"/>
                                <field name="default_reference"/>
                            </tree>
                            <form>
                                <group>
                                    <group>
                                        <field name="sequence"/>
                                        <field name="request_field_id"/>
                                        <field name="transaction_field_mapping"/>
                                        <field name="request_field_type" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="required"/>
                                        <field name="default_char_value" invisible="request_field_type != 'char'"/>
                                        <field name="default_reference" invisible="request_field_type != 'many2one'"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

