<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="res_config_settings_view_form" model="ir.ui.view">
		<field name="name">res.config.settings.view.form.inherit.l10n_uy_pos_cfe_print</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//setting[@id='basic_receipt']" position="after">
				<setting id="download_invoice_fe" string="Descargar factura FE"
						help="Descargar, mostrar e imprimir el PDF del CFE de Uruware en lugar de la factura y el recibo de Odoo.">
					<field name="pos_download_invoice_fe"/>
				</setting>
			</xpath>
		</field>
	</record>
</odoo>
