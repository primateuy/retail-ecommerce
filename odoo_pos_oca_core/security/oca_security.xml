<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Anular o devolver un cobro desde la transacción manda plata de vuelta al
        cliente sin pasar por la venta, y crear su pago asociado mete un ingreso en
        contabilidad sin pasar por ella: el grupo no se hereda de ningún otro y no
        lo trae nadie de entrada, ni el administrador. Se asigna a mano a quien
        corresponda (en Forum, sólo al usuario de soporte).
    -->
    <record id="group_oca_reverso" model="res.groups">
        <field name="name">OCA: corregir cobros (anular / devolver / crear pago)</field>
        <field name="comment">Muestra los botones «Anular / Devolver en OCA» y «Crear pago asociado» en las transacciones OCA.</field>
    </record>
</odoo>