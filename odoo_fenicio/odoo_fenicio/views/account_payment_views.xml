<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="account_payment_form">
            <field name="name">account_payment_form</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet//group" position="after">
                    <group name="e_fenicio" string="e-Fenicio" invisible="not id_fenicio">
                        <group>
                            <field name="id_fenicio"/>
                            <field name="id_externo"/>
                            <field name="codigo"/>
                            <field name="conector"/>
                            <field name="estado"/>
                        </group>
                        <group>
                            <field name="fecha_vencimiento"/>
                            <field name="fecha_cancelacion"/>
                            <field name="cuotas"/>
                            <field name="bin"/>
                            <field name="autorizacion"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>