<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_auto_code" model="ir.ui.view">
            <field name="name">product_template_form_auto_code</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="codificar_plantilla" type="object" string="Codificar plantilla" class="btn-secondary" invisible="not auto_code_enabled"/>
                    <button name="codificar_variantes" type="object" string="Codificar variantes" class="btn-secondary" invisible="not auto_code_enabled or product_variant_count == 1"/>
                    <button name="codificar_todo" type="object" string="Codificar todo" class="btn-secondary"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Código automático" name="auto_code">
                        <group>
                            <group>
                                <field name="auto_code_enabled"/>
                                <field name="code_domain_id" required="auto_code_enabled"/>
                                <field name="codigo_template"/>
                            </group>
                            <group/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo> 