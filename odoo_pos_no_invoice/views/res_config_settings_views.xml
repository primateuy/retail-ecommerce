<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_inherit_receipt_logo" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.receipt.logo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='company_details_settings']" position="after">
                <setting string="Logo de Rutina de Impresión POS"
                         help="Logo que aparece en el encabezado del ticket del POS. Si no se configura, se usa el logo general de la empresa."
                         company_dependent="1">
                    <field name="pos_receipt_logo" widget="image"
                           options="{'preview_image': 'pos_receipt_logo', 'size': [128, 128]}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
