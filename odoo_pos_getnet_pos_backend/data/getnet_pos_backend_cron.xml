<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            La red del §8.2 del contrato: liberar un pedido reversa lo que el
            POS alcanza a ver EN ESE MOMENTO. Lo que se resuelve DESPUÉS —la
            transacción que quedó en «no sé» y el cron del núcleo la aprobó,
            o la línea que se descartó creyendo que no había pasado nada— no
            lo mira nadie. Esto lo mira.

            Cada 10 minutos y no cada 5: no compite con el cron de
            recuperación del núcleo, que es el que resuelve las transacciones
            en vuelo. Éste recoge lo que aquél dejó resuelto.
        -->
        <record id="ir_cron_getnet_reversar_huerfanas_pos_backend" model="ir.cron">
            <field name="name">Getnet POS Backend: reversar cobros aprobados sin dueño</field>
            <field name="model_id" ref="payment.model_payment_transaction"/>
            <field name="state">code</field>
            <field name="code">model._getnet_cron_reversar_huerfanas_pos_backend()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
