<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_partner_defaults" model="ir.ui.view">
        <field name="name">pos.config.form.partner.defaults</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'o_settings_container')][contains(@invisible, 'pos_config_create_mode') and not(contains(@invisible, 'not'))]" position="inside">
                <setting
                    string="POS Partner Defaults"
                    help="Valores por defecto al crear clientes en el POS."
                >
                    <div class="content-group mt16">
                        <div class="row">
                            <label for="default_partner_street" class="col-lg-4 o_light_label" />
                            <field name="default_partner_street" />
                        </div>
                        <div class="row">
                            <label for="default_partner_city" class="col-lg-4 o_light_label" />
                            <field name="default_partner_city" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
