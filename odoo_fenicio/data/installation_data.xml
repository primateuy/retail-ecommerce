<odoo noupdate="1">
    <data>

        
        <record id="payment_method_fenicio" model="payment.method">
            <field name="name">Fenicio</field>
            <field name="code">fenicio</field>
            <field name="sequence">1000</field>
            <field name="active">True</field>
            <field name="image" type="base64" file="odoo_fenicio/static/description/icon.png"/>
            <field name="support_tokenization">False</field>
            <field name="support_express_checkout">False</field>
            <field name="supported_country_ids" eval="[Command.set([ ref('base.uy'), ])]"/>
            <field name="supported_currency_ids" eval="[Command.set([ ref('base.UYU'), ref('base.USD'), ])]"/>
        </record>

        <record id="payment_provider_fenicio" model="payment.provider">
            <field name="name">Fenicio</field>
            <field name="code">fenicio</field>
            <field name="state">test</field>
            <field name="image_128" type="base64" file="odoo_fenicio/static/description/icon.png"/>
            <field name="allow_tokenization">false</field>
            <field name="payment_method_ids" eval="[(6, 0, [ ref('odoo_fenicio.payment_method_fenicio'), ref('payment.payment_method_card'), ])]"/>
            <field name="company_id" eval="ref('base.main_company')"/>
        </record>

        <record id="account_journal_fenicio" model="account.journal">
            <field name="name">Fenicio</field>
            <field name="code">FENI</field>
            <field name="type">bank</field>
        </record>

    </data>
</odoo>
