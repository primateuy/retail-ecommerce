<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_pricelist_item_form_view_inherit_price_group" model="ir.ui.view">
            <field name="name">product.pricelist.item.form.inherit.price.group</field>
            <field name="model">product.pricelist.item</field>
            <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='applied_on']" position="before">
                    <field name="solo_lectura_campos" invisible="1"/>
                    <field name="visible_cantidad_minima" invisible="1"/>
                </xpath>

                <xpath expr="//field[@name='compute_price']" position="attributes">
                    <attribute name="readonly">solo_lectura_campos == True</attribute>
                </xpath>

                <xpath expr="//field[@name='fixed_price']" position="attributes">
                    <attribute name="readonly">solo_lectura_campos == True</attribute>
                </xpath>

                <xpath expr="//field[@name='applied_on']" position="attributes">
                    <attribute name="readonly">solo_lectura_campos == True</attribute>
                </xpath>

                <xpath expr="//field[@name='product_id']" position="attributes">
                    <attribute name="readonly">solo_lectura_campos == True</attribute>
                </xpath>

                <xpath expr="//field[@name='date_start']" position="attributes">
                    <attribute name="readonly">solo_lectura_campos == True</attribute>
                </xpath>

                <xpath expr="//field[@name='date_end']" position="attributes">
                    <attribute name="readonly">solo_lectura_campos == True</attribute>
                </xpath>

                <xpath expr="//field[@name='min_quantity']" position="attributes">
                    <attribute name="invisible">visible_cantidad_minima == False</attribute>
                </xpath>
            </field>
        </record>

        <record id="product_pricelist_form_price_group" model="ir.ui.view">
            <field name="name">product_pricelist_form_price_group</field>
            <field name="model">product.pricelist</field>
            <field name="inherit_id" ref="product.product_pricelist_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='item_ids']/tree[@editable='bottom']/field[@name='product_tmpl_id']" position="after">
                    <field name="solo_lectura_campos" column_invisible="1"/>
                    <field name="visible_cantidad_minima" column_invisible="1"/>
                </xpath>

                <xpath expr="//field[@name='item_ids']/tree[@editable='bottom']/field[@name='product_tmpl_id']" position="attributes">
                    <attribute name="readonly">solo_lectura_campos == True</attribute>
                </xpath>

                <xpath expr="//field[@name='item_ids']/tree[@editable='bottom']/field[@name='product_id']" position="attributes">
                    <attribute name="readonly">solo_lectura_campos == True</attribute>
                </xpath>

                <xpath expr="//field[@name='item_ids']/tree[@editable='bottom']/field[@name='fixed_price']" position="attributes">
                    <attribute name="readonly">solo_lectura_campos == True</attribute>
                </xpath>

                <xpath expr="//field[@name='item_ids']/tree[@editable='bottom']/field[@name='date_start']" position="attributes">
                    <attribute name="readonly">solo_lectura_campos == True</attribute>
                </xpath>

                <xpath expr="//field[@name='item_ids']/tree[@editable='bottom']/field[@name='date_end']" position="attributes">
                    <attribute name="readonly">solo_lectura_campos == True</attribute>
                </xpath>

                <xpath expr="//field[@name='item_ids']/tree[@editable='bottom']/field[@name='min_quantity']" position="attributes">
                    <attribute name="readonly">visible_cantidad_minima == False</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
