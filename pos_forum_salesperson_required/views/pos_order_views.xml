<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_salesperson" model="ir.ui.view">
        <field name="name">pos.order.form.salesperson</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_fields']/field[@name='user_id']" position="after">
                <field name="order_salesperson_id" />
            </xpath>
        </field>
    </record>
</odoo>
