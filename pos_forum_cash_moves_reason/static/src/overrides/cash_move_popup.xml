<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_forum_cash_moves_reason.CashMovePopup" t-inherit="point_of_sale.CashMovePopup" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[@class='form-floating']" position="before">
            <div class="form-floating mb-2" t-if="cashMoveReasons.length">
                <select class="form-select" t-model="state.move_reason_id">
                    <option t-att-value="0">Seleccione un motivo</option>
                    <t t-foreach="cashMoveReasons" t-as="reason" t-key="reason.id">
                        <option t-att-value="reason.id">
                            <t t-esc="reason.name" />
                        </option>
                    </t>
                </select>
                <label>Motivo</label>
            </div>
        </xpath>
    </t>
</templates>
