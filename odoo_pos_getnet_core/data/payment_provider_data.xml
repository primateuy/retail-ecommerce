<?xml version="1.0" encoding="utf-8"?>
<!--
    EL PROVEEDOR SE CREA SOLO AL INSTALAR, Y NACE APAGADO.

    Hasta acá no existía: el módulo declaraba el `payment.method` y los dos
    `account.payment.method`, pero nunca el proveedor. En staging se había
    creado a mano y nadie lo notó; en una instalación limpia no aparece nada y
    la guía decía «creá el proveedor», que es pedirle a quien implanta que
    adivine el `code`. El mismo hueco está en la rama 17.0.

    Se sigue el patrón de los módulos `payment_*` del core: `noupdate="1"`
    —para que una actualización NO pise lo que el cliente configuró— y
    `module_id`, que es lo que hace que Odoo lo reconozca como el proveedor de
    este módulo y lo duplique al crear una compañía nueva.

    NACE `disabled` Y SIN CREDENCIALES, y eso no es prolijidad: un proveedor de
    pago activo con credenciales vacías es un medio de cobro que parece
    disponible y no cobra. Queda visible para que se completen las
    credenciales, y habilitarlo es un acto deliberado de quien las tiene.

    NO se le enlazan `payment_method_ids` a propósito: este proveedor cobra en
    un pinpad, no en un checkout web. Enlazarlo activaría el método de pago y
    lo ofrecería donde no corresponde.
-->
<odoo noupdate="1">

    <record id="payment_provider_getnet" model="payment.provider">
        <field name="name">Getnet (TransAct)</field>
        <field name="code">getnet</field>
        <field name="state">disabled</field>
        <field name="module_id" ref="base.module_odoo_pos_getnet_core"/>
        <!-- Credenciales VACÍAS. Se cargan por configuración, nunca acá:
             el hash es una password y es distinta en integración y en
             producción. -->
        <field name="getnet_url_webservice"></field>
        <field name="getnet_emp_cod"></field>
        <field name="getnet_emp_hash"></field>
        <!-- Defaults seguros: una sola terminal y sin emulación. El modo
             emulación hace que el concentrador conteste sin pinpad, así que
             encendido por defecto sería un cobro que aprueba sin tarjeta. -->
        <field name="getnet_is_multiple" eval="False"/>
        <field name="getnet_modo_emulacion" eval="False"/>
    </record>

</odoo>
