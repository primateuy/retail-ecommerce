<odoo>
    <data>

        <record id="action_guia_talles" model="ir.actions.act_window">
            <field name="name">Guías de Talles</field>
            <field name="res_model">guia.talles</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p>Vista de las guías de talles disponibles.</p>
            </field>
        </record>

        <record id="view_guia_talles_form" model="ir.ui.view">
    <field name="name">guia.talles.form</field>
    <field name="model">guia.talles</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <field name="image" widget="image" class="oe_avatar"/>
                <div class="oe_title">
                    <h1>
                        <field name="name" placeholder="Nombre de la guía"/>
                    </h1>
                </div>
                <group>
                    <group>
                        <field name="code" />
                        <field name="sequence" />
                        <field name="active" />
                    </group>
                    
                </group>
                <group>
                    <field name="description" />
                </group>
            </sheet>
        </form>
    </field>
</record>
        <record id="view_guia_talles_tree" model="ir.ui.view">
            <field name="name">guia.talles.tree</field>
            <field name="model">guia.talles</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="code" />
                    <field name="name" />
                    <field name="active" />
                </tree>
            </field>
        </record>

        <menuitem id="menu_guia_talles" name="Guía de talles" action="action_guia_talles" parent="stock.menu_stock_inventory_control" sequence="10"/>


    </data>
</odoo>