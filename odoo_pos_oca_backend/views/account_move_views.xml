<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Form de factura: oculta el botón «Registrar pago» estándar (lanza el
            wizard account.payment.register) y agrega uno nuevo que abre el form
            de account.payment directamente con la factura precargada.
        -->
        <record id="account_move_form_oca_register_payment" model="ir.ui.view">
            <field name="name">account.move.form.oca.register.payment</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="priority" eval="50"/>
            <field name="arch" type="xml">
                <!-- Ocultar el botón estándar de registrar pago. -->
                <xpath expr="//button[@name='action_register_payment']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Nuevo botón (mismas condiciones de visibilidad que el estándar). -->
                <xpath expr="//button[@name='action_register_payment']" position="before">
                    <button name="action_oca_register_payment"
                            string="Registrar pago"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'posted' or payment_state not in ('not_paid', 'partial', 'in_payment') or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
                </xpath>
            </field>
        </record>

        <!--
            Tree de facturas: oculta el botón "Registrar pago" del header
            (que lanza el wizard estándar). Aparecía junto a "Imprimir" y
            confunde con nuestro flow custom.
        -->
        <record id="account_move_tree_oca_hide_register_payment" model="ir.ui.view">
            <field name="name">account.move.tree.oca.hide.register.payment</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_register_payment']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <!--
            Server action para la grilla de facturas: «Registrar pago OCA»
            (agrupado). Aparece en el menú Acción de la vista tree.
            Usa active_ids como fallback por si ``records`` no trae los
            seleccionados (algunos contextos UI pasan solo active_ids).
        -->
        <record id="action_server_oca_register_payment" model="ir.actions.server">
            <field name="name">Registrar pago</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">moves = records or env['account.move'].browse(env.context.get('active_ids') or [])
action = moves.action_oca_register_payment() if moves else {'type': 'ir.actions.act_window_close'}</field>
        </record>
    </data>
</odoo>
