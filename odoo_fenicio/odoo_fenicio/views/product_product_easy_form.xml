<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_product_easy_form" model="ir.ui.view">
            <field name="name">product_product_easy_form</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <!-- Opción 1: Agregar después de cualquier página existente -->
                <xpath expr="//notebook" position="inside">
                    <page name="fenicio" string="Fenicio">

                        <group>
                            <field name="listaPrecios" placeholder="Agregar una lista de precios"/>
                        </group>
                        <group>
                            <!-- <field name="precios_fenicio_ids">
                                <tree editable="bottom" default_order="price_type,currency_id">
                                    <field name="product_id" column_invisible="True"/>
                                    <field name="price_type" required="True"/>
                                    <field name="currency_id" required="True"/>
                                    <field name="price" required="True"/>
                                    
                                    <field name="listaPrecios"/>
                                </tree>

                            </field> -->

                            <field name="precios_alternativos_fenicio_ids">
                                <tree>
                                    <field name="product_id" column_invisible="True"/>
                                    <field name="code" required="True"/>
                                    <field name="precios_lista_venta_ids" widget="many2many_tags"/>
                                </tree>

                                <form>
                                    <group>
                                        <group colspan="2">
                                            <field name="product_id" invisible="True"/>
                                            <field name="code" required="True"/>
                                            <field name="precios_lista_venta_ids">
                                                <tree editable="bottom" default_order="price_type,currency_id">
                                                    <field name="alternative_price_id" column_invisible="True"/>
                                                    <field name="price_type" required="True"/>
                                                    <field name="currency_id" required="True"/>
                                                    <field name="price" required="True"/>
                                                </tree>
                                            </field>
                                        </group>
                                    </group>
                                </form>
                            </field>

                            <field name="indentificadores_ids">
                                <tree editable="bottom">
                                    <field name="product_id" column_invisible="True"/>
                                    <field name="code" required="True"/>
                                    <field name="value" required="True"/>
                                </tree>
                            </field>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>