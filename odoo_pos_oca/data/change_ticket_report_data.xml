<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 
        Reporte de ejemplo para Ticket de Cambio
        Este es un reporte básico que puede ser personalizado según las necesidades
        -->
        <record id="action_report_pos_order_change_ticket" model="ir.actions.report">
            <field name="name">Ticket de Cambio POS</field>
            <field name="model">pos.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">odoo_pos_oca.change_ticket_report</field>
            <field name="report_file">odoo_pos_oca.change_ticket_report</field>
            <field name="print_report_name">'Ticket de Cambio - %s' % (object.name)</field>
            <field name="binding_model_id" ref="point_of_sale.model_pos_order"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Template QWeb para el ticket de cambio -->
        <!-- El XML ID debe coincidir con el report_name para que el sistema pueda encontrarlo -->
        <record id="change_ticket_report" model="ir.ui.view">
            <field name="name">odoo_pos_oca.change_ticket_report</field>
            <field name="model">pos.order</field>
            <field name="type">qweb</field>
            <field name="arch" type="xml">
                <t t-call="web.html_container">
                    <t t-foreach="docs" t-as="o">
                        <t t-call="web.external_layout">
                            <div class="page">
                                <div class="oe_structure"/>
                                
                                <!-- Encabezado del Ticket -->
                                <div class="row mt16 mb16">
                                    <div class="col-12 text-center">
                                        <h2>TICKET DE CAMBIO</h2>
                                        <t t-set="ticket_number" t-value="o.pos_reference or o.name"/>
                                        <t t-set="order_number" t-value="o.name or o.pos_reference"/>
                                        <p><strong>Número de ticket:</strong> <span t-esc="ticket_number"/></p>
                                        <p><strong>Orden asociada:</strong> <span t-esc="order_number"/></p>
                                        <p><strong>Fecha:</strong> <span t-field="o.date_order" t-options='{"widget": "datetime"}'/></p>
                                    </div>
                                </div>

                                <!-- Información de la Sucursal -->
                                <t t-set="branch_partner"
                                   t-value="(o.config_id.picking_type_id.warehouse_id.partner_id if o.config_id and o.config_id.picking_type_id and o.config_id.picking_type_id.warehouse_id and o.config_id.picking_type_id.warehouse_id.partner_id else (o.config_id.company_id.partner_id if o.config_id and o.config_id.company_id else o.company_id.partner_id))"/>
                                <div class="row mb16" t-if="branch_partner">
                                    <div class="col-12">
                                        <h4 t-if="o.config_id" t-esc="o.config_id.name"/>
                                        <p t-if="branch_partner.street"><span t-field="branch_partner.street"/></p>
                                        <p t-if="branch_partner.city">
                                            <span t-field="branch_partner.city"/>
                                            <t t-if="branch_partner.state_id">, <span t-field="branch_partner.state_id.name"/></t>
                                        </p>
                                        <p t-if="branch_partner.vat">RUT: <span t-field="branch_partner.vat"/></p>
                                    </div>
                                </div>

                                <!-- Datos del comprobante electrónico -->
                                <t t-set="cfe_serie_num" t-value="o.account_move and o.account_move.cfe_serie_num or ''"/>
                                <t t-set="cfe_type_code" t-value="cfe_serie_num.split('-')[0] if cfe_serie_num and '-' in cfe_serie_num else (o.account_move.cfe_type if o.account_move and o.account_move.cfe_type else '')"/>
                                <t t-set="cfe_type_name" t-value="('eTicket' if cfe_type_code in ['101', '111'] else ('eFactura' if cfe_type_code in ['112'] else cfe_type_code))"/>
                                <div class="row mb16" t-if="cfe_type_name or cfe_serie_num">
                                    <div class="col-12">
                                        <p><strong>Tipo de comprobante electrónico:</strong> <span t-esc="cfe_type_name"/></p>
                                        <p t-if="cfe_serie_num"><strong>CFE:</strong> <span t-esc="cfe_serie_num"/></p>
                                    </div>
                                </div>

                                <!-- Código de barras de la orden asociada -->
                                <div class="row mb16" t-if="order_number">
                                    <div class="col-12 text-center">
                                        <img t-att-src="'/report/barcode/Code128/%s?width=300&amp;height=80' % (order_number.replace(' ', '%20'))"
                                             style="max-width:100%; height:auto;"/>
                                        <div style="font-size:11px; margin-top:4px;">
                                            <span t-esc="order_number"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Pie de página -->
                                <div class="row mt16">
                                    <div class="col-12 text-center">
                                        <p class="text-muted">Gracias por su compra</p>
                                        <p class="text-muted" t-if="o.session_id">
                                            Sesión: <span t-field="o.session_id.name"/>
                                        </p>
                                    </div>
                                </div>

                                <!-- Texto final configurable -->
                                <div class="row mt16" t-if="o.config_id and o.config_id.change_ticket_note">
                                    <div class="col-12 text-center">
                                        <div t-raw="o.config_id.change_ticket_note"/>
                                    </div>
                                </div>

                                <div class="oe_structure"/>
                            </div>
                        </t>
                    </t>
                </t>
            </field>
        </record>
    </data>
</odoo>
