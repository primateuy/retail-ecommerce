<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_payment_transaction_form_inherit_brands" model="ir.ui.view">
        <field name="name">payment.transaction.form.inherit.brands</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <!-- En el grupo base y no junto a issuer_code: ese grupo es solo OCA y se
                 oculta en POS Manual y demás proveedores. -->
            <xpath expr="//group[@name='transaction_details']/field[@name='payment_method_id']"
                   position="after">
                <field name="shopping_payment_code"/>
            </xpath>
        </field>
    </record>

</odoo>
