<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <data>
        <!-- Método de pago Fiserv (payment.method) -->
        <record id="payment_method_fiserv" model="payment.method">
            <field name="name">Fiserv ITD</field>
            <field name="code">fiserv</field>
            <field name="sequence">1001</field>
            <field name="active">True</field>
            <field name="image" type="base64" file="payment/static/img/card.png"/>
            <field name="support_tokenization">False</field>
            <field name="support_express_checkout">False</field>
            <field name="supported_country_ids" eval="[(6, 0, [ref('base.uy')])]"/>
            <field name="supported_currency_ids"
                   eval="[(6, 0, [ref('base.UYU'), ref('base.USD')])]"/>
        </record>

        <!-- Proveedor de pago Fiserv (credenciales reales en backoffice) -->
        <record id="payment_provider_fiserv" model="payment.provider">
            <field name="name">Fiserv ITD</field>
            <field name="code">fiserv</field>
            <field name="state">test</field>
            <field name="allow_tokenization">True</field>
            <field name="payment_method_ids"
                   eval="[(6, 0, [
                       ref('odoo_pos_fiserv.payment_method_fiserv'),
                       ref('payment.payment_method_card'),
                   ])]"/>
            <field name="company_id" eval="ref('base.main_company')"/>
        </record>

        <!-- Método inbound en contabilidad -->
        <record id="account_payment_method_fiserv" model="account.payment.method">
            <field name="name">Fiserv ITD</field>
            <field name="code">fiserv</field>
            <field name="payment_type">inbound</field>
        </record>

        <!-- Diario banco (completado en post_init con métodos de pago) -->
        <record id="account_journal_fiserv" model="account.journal">
            <field name="name">Fiserv ITD</field>
            <field name="code">FSVR</field>
            <field name="type">bank</field>
            <field name="company_id" eval="ref('base.main_company')"/>
        </record>

        <!-- Método POS terminal Fiserv (URL/IDs de ejemplo; ajustar por ambiente) -->
        <record id="pos_payment_method_fiserv" model="pos.payment.method">
            <field name="name">Fiserv ITD</field>
            <field name="use_payment_terminal">fiserv</field>
            <field name="is_cash_count" eval="False"/>
            <field name="active">True</field>
            <field name="fiserv_provider_id" ref="odoo_pos_fiserv.payment_provider_fiserv"/>
            <field name="url_webservice">https://testitd.firstdata.com/v2/ITDService</field>
            <field name="codigo_sistema">1</field>
            <field name="codigo_terminal">001</field>
            <field name="client_app_id">1</field>
            <field name="codigo_sucursal">1</field>
        </record>

        <record id="fiserv_default_config_url" model="ir.config_parameter">
            <field name="key">fiserv.default_url</field>
            <field name="value">https://testitd.firstdata.com/v2/ITDService</field>
        </record>

        <record id="fiserv_default_config_timeout" model="ir.config_parameter">
            <field name="key">fiserv.default_timeout</field>
            <field name="value">30</field>
        </record>

        <record id="fiserv_default_config_retry_attempts" model="ir.config_parameter">
            <field name="key">fiserv.retry_attempts</field>
            <field name="value">3</field>
        </record>
    </data>
</odoo>
