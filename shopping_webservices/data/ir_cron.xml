<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tarea programada para evaluar y declarar ventas diariamente -->
        <record id="cron_evaluar_ventas_shopping" model="ir.cron">
            <field name="name">Evaluar y Declarar Ventas Shopping - Diariamente</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.evaluarVentas()</field>
            <!-- Configuración de frecuencia: una vez al día -->
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- Hora de ejecución: 02:00 AM (2 de la madrugada) -->
            <field name="nextcall">2026-02-07 02:00:00</field>
            <field name="numbercall">-1</field> <!-- -1 = infinito -->
            <field name="doall">False</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
