<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_auto_code" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.auto.code</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//setting[@id='manage_product_packaging']" position="after">
                    <setting id="product_code_total_length" title=" Largo total del código generado (plantilla + variantes). 0 = sin límite." help=" Largo total del código generado (plantilla + variantes). 0 = sin límite.">
                        <field name="product_code_total_length"/>
                        <div class="content-group">
                            <div class="mt8">
                                <button name="action_configure_code_domains" icon="oi-arrow-right" type="object" string="Versión / Origen" class="btn-link"/>
                            </div>
                        </div>
                    </setting>
                </xpath>
            </field>
        </record>

    </data>
</odoo> 