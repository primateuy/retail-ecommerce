<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Los campos OCA deben ir FUERA de group2 (Diario / método de pago).
            Insertarlos tras payment_method_line_id rompía el layout de dos columnas y
            las etiquetas de Diario, Método de pago y campos siguientes del formulario estándar.
        -->
        <record id="account_payment_form_oca_terminal" model="ir.ui.view">
            <field name="name">account.payment.form.oca.terminal</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="priority" eval="50"/>
            <field name="arch" type="xml">
                <!--
                    Botón «Confirmar» estándar: oculto mientras el pago use terminal
                    OCA y la transacción no esté aprobada. También oculto durante
                    el hilo ITD activo. Fuera del flujo OCA, se comporta como siempre.
                -->
                <xpath expr="//button[@name='action_post']" position="attributes">
                    <attribute name="invisible">state != 'draft' or pos_integrated_post_blocked</attribute>
                </xpath>
                <!-- Ocultar botones de facturación electrónica UY
                     (``l10n_uy_einvoice_uruware``) cuando el pago usa terminal
                     integrado OCA: el flujo correcto es Crear transacción →
                     Confirmar; los CFE se generan desde la factura, no desde
                     el pago. Si el usuario desmarca "Cobrar en terminal",
                     vuelven a verse. -->
                <xpath expr="//button[@name='facturar']" position="attributes">
                    <attribute name="invisible">
                        move_type in ('entry', 'in_invoice', 'in_refund', 'in_receipt') or oca_charge_on_pos
                    </attribute>
                </xpath>
                <xpath expr="//button[@name='obtener_pdf'][not(@icon)]" position="attributes">
                    <attribute name="invisible">
                        move_type in ('entry', 'in_invoice', 'in_refund', 'in_receipt') or oca_charge_on_pos
                    </attribute>
                </xpath>
                <!--
                    Botón «Cancelar» estándar: oculto cuando la transacción OCA
                    fue aprobada o hay una operación en curso.
                -->
                <xpath expr="//button[@name='action_cancel']" position="attributes">
                    <attribute name="invisible">state != 'draft' or pos_integrated_cancel_blocked</attribute>
                </xpath>
                <!--
                    Ocultar el ``payment_transaction_id`` nativo (heredado de ``account_payment``)
                    cuando la transacción es OCA: lo reemplazamos por uno propio con label
                    amigable dentro del grupo "Cobro con terminal OCA".
                -->
                <xpath expr="//field[@name='payment_transaction_id'][@groups='base.group_no_one']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!--
                    Nuevo botón «Crear transacción»: visible solo cuando el pago usa
                    terminal OCA, está en borrador, no hay transacción previa aprobada
                    y el hilo ITD no está en curso. Al pulsarlo se envía al pinpad y se
                    espera la aprobación; el botón «Confirmar» aparece luego.
                -->
                <xpath expr="//button[@name='action_post']" position="before">
                    <field name="oca_is_integrated_journal" invisible="1"/>
                    <field name="oca_tx_is_done" invisible="1"/>
                    <field name="oca_tx_state" invisible="1"/>
                    <field name="oca_source_invoice_ids" invisible="1" widget="many2many_tags"/>
                    <field name="pos_integrated_post_blocked" invisible="1"/>
                    <field name="pos_integrated_cancel_blocked" invisible="1"/>
                    <button name="action_oca_create_transaction"
                            type="object"
                            string="Crear transacción"
                            class="oe_highlight"
                            invisible="state != 'draft' or oca_async_terminal_pending or not oca_charge_on_pos or oca_tx_is_done"/>
                </xpath>
                <!-- Banner de procesamiento OCA: visible mientras el hilo ITD está activo -->
                <xpath expr="//group[@name='main_group']" position="before">
                    <field name="oca_async_terminal_pending" invisible="1"/>
                    <div role="alert" class="alert alert-warning text-center"
                         invisible="not oca_async_terminal_pending">
                        <i class="fa fa-spinner fa-spin me-2"/>
                        <strong>Procesando cobro en terminal OCA... Espere por favor.</strong>
                    </div>
                    <div role="alert" class="alert alert-success text-center"
                         invisible="not oca_tx_is_done or state != 'draft'">
                        <i class="fa fa-check-circle me-2"/>
                        <strong>Transacción OCA aprobada. Pulse «Confirmar» para registrar el pago.</strong>
                    </div>
                </xpath>
                <xpath expr="//group[@name='main_group']" position="after">
                    <!--
                        Visible también en Registrado: el usuario debe ver que el cobro fue por OCA
                        y qué PosID se usó. En borrador se edita; confirmado solo lectura.
                    -->
                    <group
                        string="Cobro con terminal OCA (contabilidad)"
                        name="oca_terminal_account_group"
                        colspan="2"
                        invisible="is_internal_transfer or payment_type not in ('inbound', 'outbound') or (not oca_is_oca_payment_line and (not payment_transaction_id or oca_payment_tx_provider_code != 'oca'))">
                        <field name="oca_payment_tx_provider_code" invisible="1"/>
                        <field name="oca_is_oca_payment_line" invisible="1"/>
                        <field name="oca_selectable_pos_ids" invisible="1"/>
                        <field name="oca_need_pos_choice" invisible="1"/>
                        <field name="oca_charge_on_pos" readonly="state != 'draft'"/>
                        <field name="oca_multiple_pos_id"
                               options="{'no_create': True}"
                               readonly="state != 'draft'"
                               invisible="not oca_charge_on_pos or (state != 'draft' and not oca_multiple_pos_id)"/>
                        <field name="payment_transaction_id"
                               string="Transacción OCA (payment.transaction)"
                               options="{'no_create': True}"
                               readonly="1"
                               invisible="not payment_transaction_id or oca_payment_tx_provider_code != 'oca'"/>
                    </group>
                    <group
                        string="Devolución con terminal OCA"
                        name="oca_refund_account_group"
                        colspan="2"
                        invisible="payment_type != 'outbound' or is_internal_transfer or (state == 'draft' and not oca_charge_on_pos) or (state != 'draft' and not oca_original_transaction_id)">
                        <field name="oca_original_transaction_id"
                               options="{'no_create': True}"
                               readonly="state != 'draft'"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
