<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oca_reverso_wizard_form" model="ir.ui.view">
        <field name="name">oca.reverso.wizard.form</field>
        <field name="model">oca.reverso.wizard</field>
        <field name="arch" type="xml">
            <form string="Anular / Devolver en OCA">
                <div class="alert alert-warning" role="alert">
                    Se anula el cobro completo por número de ticket en la terminal donde se hizo.
                    Si el lote de esa terminal ya cerró, se hace la devolución.
                    No se crea ningún asiento: este cobro no está en ninguna venta.
                </div>
                <group>
                    <group>
                        <field name="transaction_id"/>
                        <field name="tx_date"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="pos_id"/>
                        <field name="ticket_number"/>
                        <field name="authorization_code"/>
                        <field name="card_last_four"/>
                    </group>
                </group>
                <field name="motivo" placeholder="Por qué se anula (ej.: cobro repetido, venta perdida; ticket de helpdesk)"/>
                <footer>
                    <button name="action_confirmar" type="object" string="Enviar a la terminal" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
