<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_branch" model="ir.ui.view">
        <field name="name">res.users.form.branch</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Sucursales" name="branch">
                    <field name="branch_warehouse_ids" nolabel="1"
                           widget="many2many_tags"
                           options="{'no_create': True}"
                           domain="[('is_branch', '=', True)]"/>
                    <div colspan="2" class="text-muted">
                        Asignar una sucursal agrega automáticamente a las compañías
                        permitidas del usuario la compañía del almacén y la de su PDV.
                        Nunca quita compañías.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
