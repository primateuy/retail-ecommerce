<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_fenicio" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fenicio</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//form" position="inside">
                <app string="Fenicio" name="odoo_fenicio">
                    <block title="Configuración de Fenicio" name="fenicio_settings">
                        <setting id="fenicio_website_setting" help="Seleccione el sitio web donde se registrarán las ventas procesadas por Fenicio">
                            <field name="fenicio_website_id" class="oe_inline"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>