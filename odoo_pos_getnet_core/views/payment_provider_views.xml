<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="payment_provider_form_getnet" model="ir.ui.view">
            <field name="name">payment.provider.form.getnet</field>
            <field name="model">payment.provider</field>
            <field name="inherit_id" ref="payment.payment_provider_form"/>
            <field name="arch" type="xml">
                <group name="provider_credentials" position="inside">
                    <group string="Getnet (TransAct)" invisible="code != 'getnet'">
                        <field name="getnet_is_multiple"/>
                        <field name="getnet_url_webservice" required="code == 'getnet'"/>
                        <field name="getnet_emp_cod" required="code == 'getnet'"/>
                        <field name="getnet_emp_hash" password="True" groups="base.group_system"/>
                        <field name="getnet_modo_emulacion"/>
                    </group>
                </group>
                <xpath expr="//sheet/notebook" position="inside">
                    <page string="Terminales Getnet (TermCod)"
                          name="getnet_terminals"
                          invisible="code != 'getnet'">
                        <field name="getnet_terminal_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="term_cod"/>
                                <field name="lock_origin" readonly="1"/>
                                <field name="lock_date" readonly="1"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
