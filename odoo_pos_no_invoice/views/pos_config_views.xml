<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_inherit_no_invoice" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.no.invoice</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <!-- Agregar sección de facturación después de la última sección -->
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting string="Facturación" id="invoice_download_setting">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="download_invoice"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="download_invoice" string="Descargar factura"/>
                            <div class="text-muted">
                                Si está marcado, se mantendrá el comportamiento estándar de Odoo 
                                para descargar la factura en el POS. Si está desmarcado (por defecto), 
                                no se descargará la factura automáticamente.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_points_policy" placeholder="Ej: Puntos del ticket = 35, Saldo = 545"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_points_policy" string="Sistema de puntos"/>
                            <div class="text-muted">
                                Texto que se imprime en la adenda del ticket con el sistema de puntos.
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
