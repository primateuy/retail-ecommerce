<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Agrupadores de precio de ejemplo -->
        <record id="price_group_promocional" model="x_price_group">
            <field name="name">Promocional</field>
            <field name="code">PROMO</field>
            <field name="active">True</field>
        </record>

        <record id="price_group_mayorista" model="x_price_group">
            <field name="name">Mayorista</field>
            <field name="code">MAYOR</field>
            <field name="active">True</field>
        </record>

        <record id="price_group_minorista" model="x_price_group">
            <field name="name">Minorista</field>
            <field name="code">MINOR</field>
            <field name="active">True</field>
        </record>

        <record id="price_group_especial" model="x_price_group">
            <field name="name">Precio Especial</field>
            <field name="code">ESPEC</field>
            <field name="active">True</field>
        </record>

        <record id="price_group_black_friday" model="x_price_group">
            <field name="name">Black Friday</field>
            <field name="code">BF2024</field>
            <field name="active">True</field>
        </record>

        <!-- Secuencia para códigos de agrupador -->
        <record id="seq_price_group_code" model="ir.sequence">
            <field name="name">Secuencia Código Agrupador de Precio</field>
            <field name="code">x_price_group.code</field>
            <field name="prefix">AG</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo> 