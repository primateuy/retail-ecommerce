        <!-- Herencia de la vista de formulario de producto (variante) -->
        <record id="product_normal_form_view_inherit_price_group" model="ir.ui.view">
            <field name="name">product.product.common.form.inherit.price.group</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Agrupadores de Precio" name="price_groups">
                        <group>
                            <group>
                                <field name="x_current_price_group_id" readonly="1"/>
                                <field name="x_inherited_price_group_id" readonly="1"/>
                                <field name="x_price_group_count" widget="statinfo" string="Agrupadores Propios"/>
                            </group>
                            <group>
                                <button name="action_add_price_group" 
                                        type="object" 
                                        string="Agregar Agrupador" 
                                        class="btn-primary"
                                        invisible="x_price_group_line_ids != []"/>
                                <button name="action_inherit_from_template" 
                                        type="object" 
                                        string="Heredar del Template" 
                                        class="btn-secondary"
                                        invisible="x_price_group_line_ids != []"/>
                                <button name="action_view_price_groups" 
                                        type="object" 
                                        string="Ver Agrupadores" 
                                        class="btn-secondary"/>
                            </group>
                        </group>
                        
                        <field name="x_price_group_line_ids" readonly="1">
                            <tree string="Agrupadores de Precio">
                                <field name="price_group_id"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="origin"/>
                                <field name="is_current"/>
                                <field name="is_inherited"/>
                                <field name="active"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Herencia de la vista de lista de producto (variante) -->
        <record id="product_product_tree_view_inherit_price_group" model="ir.ui.view">
            <field name="name">product.product.common.tree.inherit.price.group</field>
            <field name="model">product.product</field>
