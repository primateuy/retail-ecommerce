<odoo>
    <data>
        <!-- Vista Form -->
        <record id="store_branches_views_form" model="ir.ui.view">
            <field name="name">store.branches.views.form</field>
            <field name="model">store.branches</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                        <button name="create_store_branch_mp" type="object" string="Create Store Branch in Mercado Pago" class="oe_highlight" invisible="mp_store_branch_id"/>
                    </header>
                    <sheet>
                        <group string="Basic Info">
                            <field name="name" placeholder="My store"/>
                            <field name="external_id" readonly="1"/>
                            <field name="mp_store_branch_id" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Business Hours" name="business_hours">
                                <field name="business_hours_ids">
                                    <tree>
                                        <field name="day"/>
                                        <field name="open_hour"/>
                                        <field name="close_hour"/>
                                    </tree>
                                    <form>
                                        <group>
                                            <field name="day"/>
                                            <field name="open_hour" placeholder="08:00"/>
                                            <field name="close_hour" placeholder="17:00"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Location" name="location">
                                <group>
                                    <group>
                                        <field name="street_number"/>
                                        <field name="street_name"/>
                                        <field name="city_name"/>
                                        <field name="state_name"/>
                                    </group>

                                    <group>
                                        <field name="latitude"/>
                                        <field name="longitude"/>
                                        <field name="reference"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Tills" name="store_tills" invisible="not external_id">
                                <field name="store_tills_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="external_id"/>
                                        <field name="category"/>
                                    </tree>
                                    <form>
                                        <group string="Still Info" name="still_info">
                                            <group>
                                                <field name="name" placeholder="Still 1"/>
                                                <field name="fixed_amount" readonly="pos_id_mp"/>
                                            </group>
                                            <group>
                                                <field name="external_id" readonly="1"/>
                                                <field name="category" readonly="pos_id_mp"/>
                                            </group>
                                        </group>
                                        <group string="MercadoPago Info" name="still_mp_info" invisible="not pos_id_mp">
                                            <group>
                                                <field name="pos_id_mp" readonly="1"/>
                                                <field name="status_mp" readonly="1"/>
                                                <field name="uuid_mp" readonly="1"/>
                                                <field name="user_id_mp" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="qr_url" readonly="1"/>
                                                <field name="qr_template_document" readonly="1"/>
                                                <field name="qr_template_image" readonly="1"/>
                                                <field name="qr_code" readonly="1"/>
                                            </group>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista tree -->
        <record id="store_branches_views_tree" model="ir.ui.view">
            <field name="name">store.branches.tree</field>
            <field name="model">store.branches</field>
            <field name="arch" type="xml">
                <tree string="">
                    <field name="name"/>
                    <field name="external_id"/>
                    <field name="mp_store_branch_id"/>
                </tree>
            </field>
        </record>

        <!-- Action -->
        <record id="store_branches_views_action" model="ir.actions.act_window">
            <field name="name">Store Branches</field>
            <field name="res_model">store.branches</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>