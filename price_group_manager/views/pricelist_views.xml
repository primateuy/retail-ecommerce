    <data>
        <!-- Herencia de la vista de formulario de regla de lista de precios -->
        <record id="product_pricelist_item_form_view_inherit_price_group" model="ir.ui.view">
            <field name="name">product.pricelist.item.form.inherit.price.group</field>
            <field name="model">product.pricelist.item</field>
            <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='applied_on']" position="before">
                    <field name="aplicar_agrupador"/>
                </xpath>

                <xpath expr="//field[@name='applied_on']" position="attributes">
                    <attribute name="invisible">aplicar_agrupador == True</attribute>
                </xpath>

                <xpath expr="//field[@name='applied_on']" position="after">
                    <field name="price_group_id" required="aplicar_agrupador" invisible="not aplicar_agrupador"/>
                </xpath>
                
                <!--<xpath expr="//group[@name='computation']" position="inside">
                    <button name="action_view_applicable_products" 
                            type="object" 
                            string="Ver Productos Aplicables" 
                            class="btn-secondary"
                            invisible="applied_on != 'price_group'"/>
                </xpath>-->
            </field>
        </record>

