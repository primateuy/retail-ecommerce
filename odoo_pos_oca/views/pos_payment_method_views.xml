<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="pos_payment_method_form" model="ir.ui.view">
            <field name="name">pos_payment_method_form</field>
            <field name="model">pos.payment.method</field>
            <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='use_payment_terminal']" position="after">
                    <field name="company_id" invisible="1"/>
                    <field name="url_webservice" invisible="use_payment_terminal != 'oca'" required="use_payment_terminal == 'oca'"/>
                    <field name="codigo_sistema" invisible="use_payment_terminal != 'oca'" required="use_payment_terminal == 'oca'"/>
                    <field name="codigo_terminal" invisible="use_payment_terminal != 'oca'" required="use_payment_terminal == 'oca'"/>
                    <field name="client_app_id" invisible="use_payment_terminal != 'oca'" required="use_payment_terminal == 'oca'"/>
                    <field name="codigo_sucursal" invisible="use_payment_terminal != 'oca'" required="use_payment_terminal == 'oca'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
