<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="pos_payment_method_form_getnet" model="ir.ui.view">
            <field name="name">pos.payment.method.form.getnet</field>
            <field name="model">pos.payment.method</field>
            <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
            <field name="arch" type="xml">
                <field name="use_payment_terminal" position="after">
                    <field name="getnet_provider_id"
                           invisible="use_payment_terminal != 'getnet'"
                           required="use_payment_terminal == 'getnet'"/>
                    <field name="getnet_terminal_id"
                           invisible="use_payment_terminal != 'getnet'"
                           domain="[('payment_provider_id', '=', getnet_provider_id)]"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
