<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_code_domain_form" model="ir.ui.view">
            <field name="name">product_code_domain_form</field>
            <field name="model">product.code.domain</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group string="Información básica">
                                <field name="name"/>
                                <field name="code"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_code_domain_tree" model="ir.ui.view">
            <field name="name">product_code_domain_tree</field>
            <field name="model">product.code.domain</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <record id="product_code_domain_search" model="ir.ui.view">
            <field name="name">product_code_domain_search</field>
            <field name="model">product.code.domain</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>