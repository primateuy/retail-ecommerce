<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Bloque BASE de configuración OCA en el form del payment.provider.
            El tab "Configuración Multiple POS" y el booleano is_multiple los
            aporta odoo_pos_oca_multiple (que extiende esta misma vista).
        -->
        <record id="payment_provider_form_oca" model="ir.ui.view">
            <field name="name">payment.provider.form.oca</field>
            <field name="model">payment.provider</field>
            <field name="inherit_id" ref="payment.payment_provider_form"/>
            <field name="arch" type="xml">
                <group name="provider_credentials" position="inside">
                    <group invisible="code != 'oca'" string="OCA POSLink" colspan="2">
                        <field name="url_webservice" required="code == 'oca'"/>
                        <field name="codigo_sistema" required="code == 'oca'"/>
                        <field name="client_app_id" required="code == 'oca'"/>
                        <field name="codigo_sucursal" required="code == 'oca'"/>
                        <field name="branch"/>
                        <field name="oca_polling_timeout"/>
                    </group>
                </group>
            </field>
        </record>
    </data>
</odoo>
